assert(is_linux)

import("//mojo/public/tools/bindings/mojom.gni")
import("//pdf/features.gni")
import("//printing/buildflags/buildflags.gni")

action("bootstrap") {
  script = "generate_bootstrap.py"
  sources = [ "bootstrap.js" ]
  outputs = [ "$target_gen_dir/host_bootstrap.h" ]
  args = [
    "--input",
    rebase_path(sources[0], root_build_dir),
    "--output",
    rebase_path(outputs[0], root_build_dir),
  ]
}

action("page_script") {
  script = "generate_page_script.py"
  sources = [ "//ardia/core/page_script.js" ]
  outputs = [ "$target_gen_dir/page_script.h" ]
  args = [
    "--input",
    rebase_path(sources[0], root_build_dir),
    "--output",
    rebase_path(outputs[0], root_build_dir),
  ]
}

mojom("page_mojom") {
  sources = [ "mojom/page.mojom" ]
}

source_set("page_agent") {
  sources = [
    "renderer/ac_linux_page_agent.cc",
    "renderer/ac_linux_page_agent.h",
  ]
  sources += get_target_outputs(":page_script")
  deps = [
    ":page_messages",
    ":page_mojom",
    ":page_script",
    "//base",
    "//chrome/common",
    "//content/public/renderer",
    "//gin",
    "//mojo/public/cpp/bindings",
    "//third_party/blink/public:blink",
    "//third_party/blink/public/common",
    "//url",
    "//v8",
  ]
}

source_set("close_hooks") {
  sources = [
    "ac_linux_close_hooks.cc",
    "ac_linux_close_hooks.h",
  ]
  deps = [ "//base" ]
}

source_set("devtools_authority") {
  sources = [
    "ac_linux_devtools_authority.cc",
    "ac_linux_devtools_authority.h",
  ]
  deps = [
    "//base",
    "//content/public/browser",
  ]
}

source_set("page_messages") {
