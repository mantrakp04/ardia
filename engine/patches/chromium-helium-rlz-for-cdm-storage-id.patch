Reverts the rlz/buildflags/buildflags.gni hunk of inox-patchset/disable-rlz.patch, which Helium applies, as Ardia's
ungoogled build did: Widevine's CDM storage id (enable_cdm_storage_id) hashes RLZ's machine id on the
Mac, so enable_rlz stays true and every user's storage ids and licences stay the same.

--- a/rlz/buildflags/buildflags.gni
+++ b/rlz/buildflags/buildflags.gni
@@ -6,7 +6,7 @@ import("//build/config/chrome_build.gni")

 # Whether we are using the rlz library or not.  Platforms like Android send
 # rlz codes for searches but do not use the library.
-enable_rlz_support = false
+enable_rlz_support = is_win || is_apple || is_chromeos

 declare_args() {
   enable_rlz = is_chrome_branded && enable_rlz_support
