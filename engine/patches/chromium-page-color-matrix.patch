+bool IsPageColorMatrix(const SkM44& mat) {
+  return mat.rc(3, 3) == 0.0f;
+}
+
+SkColorMatrix ToPageColorMatrix(const SkM44& mat) {
+  std::array<float, 20> values;
+  values.fill(0.0f);
+  for (uint32_t r = 0; r < 3; r++) {
+    values[r * 5 + 0] = mat.rc(r, 0);
+    values[r * 5 + 1] = mat.rc(r, 1);
+    values[r * 5 + 2] = mat.rc(r, 2);
+    values[r * 5 + 3] = mat.rc(3, r);
+    values[r * 5 + 4] = mat.rc(r, 3);
+  }
+  values[18] = 1.0f;
+  SkColorMatrix mat_out;
+  mat_out.setRowMajor(values.data());
+  return mat_out;
+}
