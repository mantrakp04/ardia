+void ArdiaSetPageColorFilter(RenderWidgetHostView* view, const float* hsla) {
+  if (!view) {
+    return;
+  }
+  SkM44 matrix;
+  if (hsla) {
+    for (int r = 0; r < 3; r++) {
+      matrix.setRC(r, 0, hsla[r * 5 + 0]);
+      matrix.setRC(r, 1, hsla[r * 5 + 1]);
+      matrix.setRC(r, 2, hsla[r * 5 + 2]);
+      matrix.setRC(r, 3, hsla[r * 5 + 4]);
+      matrix.setRC(3, r, hsla[r * 5 + 3]);
+    }
+    matrix.setRC(3, 3, 0.0f);
+  }
+  static_cast<RenderWidgetHostViewMac*>(view)->SetPageColorMatrix(matrix);
+}
