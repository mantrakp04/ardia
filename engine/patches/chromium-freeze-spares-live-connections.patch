+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/public/browser/ardia_live_connection.h"
+
+#include "content/browser/renderer_host/render_frame_host_impl.h"
+#include "third_party/blink/public/common/scheduler/web_scheduler_tracked_feature.h"
+
+namespace content {
+
+bool ArdiaFrameHasLiveConnection(RenderFrameHost* render_frame_host) {
+  using Feature = blink::scheduler::WebSchedulerTrackedFeature;
+  const auto features =
+      static_cast<RenderFrameHostImpl*>(render_frame_host)
+          ->GetBackForwardCacheDisablingFeatures();
+  for (Feature feature :
+       {Feature::kWebSocket, Feature::kWebSocketSticky, Feature::kWebTransport,
+        Feature::kWebTransportSticky, Feature::kWebRTC,
+        Feature::kWebRTCSticky,
+        Feature::kOutstandingNetworkRequestDirectSocket}) {
+    if (features.Has(feature)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}
