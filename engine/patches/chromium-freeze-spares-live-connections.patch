+bool ArdiaPageHasLiveConnection(const PageNode* page_node) {
+  base::WeakPtr<content::WebContents> contents = page_node->GetWebContents();
+  if (!contents) {
+    return false;
+  }
+  bool live = false;
+  contents->GetPrimaryMainFrame()->ForEachRenderFrameHost(
+      [&live](content::RenderFrameHost* frame) {
+        live = live || content::ArdiaFrameHasLiveConnection(frame);
+      });
+  return live;
+}
