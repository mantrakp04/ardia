+bool MediaWebContentsObserver::ArdiaLinuxInPrimaryPage(
+    const MediaPlayerId& id) {
+  RenderFrameHost* frame = RenderFrameHost::FromID(id.frame_routing_id);
+  return frame && frame->GetPage().IsPrimary() &&
+         WebContents::FromRenderFrameHost(frame) == web_contents_impl();
+}
+
+bool MediaWebContentsObserver::ArdiaLinuxPictureInPictureEligible(
+    const MediaPlayerId& id) {
+  const auto info = player_info_map_.find(id);
+  return info != player_info_map_.end() && info->second->has_video() &&
+         media_player_remotes_.contains(id) &&
+         session_controllers_manager()->ArdiaLinuxPictureInPictureAvailable(
+             id) &&
+         ArdiaLinuxInPrimaryPage(id);
+}
+
+std::vector<ArdiaLinuxPictureInPictureCandidate>
+MediaWebContentsObserver::ArdiaLinuxPictureInPictureCandidates() {
+  std::vector<ArdiaLinuxPictureInPictureCandidate> candidates;
+  for (const auto& [id, info] : player_info_map_) {
+    if (!ArdiaLinuxPictureInPictureEligible(id)) {
+      continue;
+    }
+    candidates.push_back({id, info->is_playing(), info->muted()});
+  }
+  return candidates;
+}
+
+bool MediaWebContentsObserver::ArdiaLinuxRequestPictureInPicture(
+    const MediaPlayerId& id) {
+  const auto it = media_player_remotes_.find(id);
+  if (it == media_player_remotes_.end() || !it->second.is_bound() ||
+      !ArdiaLinuxPictureInPictureEligible(id)) {
+    return false;
+  }
+  it->second->RequestEnterPictureInPicture(std::nullopt);
+  return true;
+}
+
+std::vector<ArdiaLinuxPictureInPictureCandidate>
+ArdiaLinuxPictureInPictureCandidates(WebContents* contents) {
+  auto* impl = static_cast<WebContentsImpl*>(contents);
+  MediaWebContentsObserver* observer =
+      impl ? impl->media_web_contents_observer() : nullptr;
+  if (!observer) {
+    return {};
+  }
+  return observer->ArdiaLinuxPictureInPictureCandidates();
+}
+
+bool ArdiaLinuxRequestPictureInPicture(WebContents* contents,
+                                       const MediaPlayerId& id) {
+  auto* impl = static_cast<WebContentsImpl*>(contents);
+  MediaWebContentsObserver* observer =
+      impl ? impl->media_web_contents_observer() : nullptr;
+  return observer && observer->ArdiaLinuxRequestPictureInPicture(id);
+}
+#endif
+
