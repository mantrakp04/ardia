Native messaging never starts Apple Passwords' helper (com.apple.passwordmanager). Its launch constraint kills it at
exec when a browser it doesn't know starts it (SIGKILL, Code Signature Invalid), so every connectNative from the
iCloud Passwords extension left a PasswordManagerBrowserExtensionHelper crash report, every few minutes. ArdiaCore
already left its manifest out (ArdiaNativeMessaging.mm); Helium's scan-chrome-native-messaging-hosts found it again in
/Library/Google/Chrome/NativeMessagingHosts. FindManifest now answers "Can't find native messaging host" for it, from
any directory.

--- a/chrome/browser/extensions/api/messaging/launch_context_posix.cc
+++ b/chrome/browser/extensions/api/messaging/launch_context_posix.cc
@@ -23,6 +23,8 @@ namespace extensions {
 
 namespace {
 
+constexpr char kAppleLaunchConstrainedHost[] = "com.apple.passwordmanager";
+
 base::FilePath FindManifestInDir(int dir_key, const std::string& host_name) {
   base::FilePath base_path;
   if (base::PathService::Get(dir_key, &base_path)) {
@@ -40,6 +42,11 @@ base::FilePath FindManifestInDir(int dir_key, const std::string& host_name) {
 base::FilePath LaunchContext::FindManifest(const std::string& host_name,
                                            bool allow_user_level_hosts,
                                            std::string& error_message) {
+  if (host_name == kAppleLaunchConstrainedHost) {
+    error_message = "Can't find native messaging host " + host_name;
+    return base::FilePath();
+  }
+
   base::FilePath result;
   if (allow_user_level_hosts) {
     result = FindManifestInDir(chrome::DIR_USER_NATIVE_MESSAGING, host_name);
