   base::FilePath base_path;
   if (base::PathService::Get(dir_key, &base_path)) {
@@ -40,6 +42,17 @@ base::FilePath FindManifestInDir(int dir_key, const std::string& host_name) {
 base::FilePath LaunchContext::FindManifest(const std::string& host_name,
                                            bool allow_user_level_hosts,
                                            std::string& error_message) {
+  if (host_name == kAppleLaunchConstrainedHost) {
+    base::FilePath granted =
+        allow_user_level_hosts
+            ? FindManifestInDir(chrome::DIR_USER_NATIVE_MESSAGING, host_name)
+            : base::FilePath();
+    if (granted.empty()) {
+      error_message = "Can't find native messaging host " + host_name;
