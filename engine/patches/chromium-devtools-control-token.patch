+bool ArdiaMayInject(DevToolsSession* session,
+                    RenderFrameHostImpl* host,
+                    RenderWidgetHostImpl* widget) {
+  if (!g_ardia_devtools_may_input) {
+    return true;
+  }
+  WebContents* contents = host ? WebContents::FromRenderFrameHost(host) : nullptr;
+  if (!session || !widget || !contents) {
+    return false;
+  }
+  DevToolsAgentHostClient* client = session->GetRootSession()->GetClient();
+  bool found = false;
+  bool allowed = true;
+  contents->ForEachRenderFrameHost([&](RenderFrameHost* frame) {
+    if (frame->GetRenderWidgetHost() == widget) {
+      found = true;
+      allowed = allowed && g_ardia_devtools_may_input(client, frame);
+    }
+  });
+  return found && allowed;
+}
