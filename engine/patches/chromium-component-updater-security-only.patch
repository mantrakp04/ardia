+update_client::protocol_request::Request MakeRequest(
+    const update_client::PersistedData& metadata) {
+  std::vector<update_client::protocol_request::App> apps;
+  apps.push_back(update_client::MakeProtocolApp(
+      kCrlSetId, base::Version("10850"), "", "GGLS",
+      metadata.GetInstallId(kCrlSetId), "en",
+      metadata.GetInstallDate(kCrlSetId), "", "", {},
+      metadata.GetCohort(kCrlSetId), metadata.GetCohortHint(kCrlSetId),
+      metadata.GetCohortName(kCrlSetId), "", {}, {kCachedPayloadHash},
+      update_client::MakeProtocolUpdateCheck(false, "", false, false), {},
+      update_client::MakeProtocolPing(kCrlSetId, &metadata, true),
