+void PersistLinkingState(update_client::PersistedData& metadata) {
+  metadata.SetDateLastData({kCrlSetId}, 7233, base::DoNothing());
+  metadata.SetCohort(kCrlSetId, "1:287f:");
+  metadata.SetCohortHint(kCrlSetId, "hint");
+  metadata.SetCohortName(kCrlSetId, "Auto full");
