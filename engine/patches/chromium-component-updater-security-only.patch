+      {GURL("http://localhost/a.crx3"), first, second}, kHash,
+      base::BindLambdaForTesting([&](const CrxDownloader::Result& r) {
+        ++results;
+        result = r;
+      }));
+
+  network::TestURLLoaderFactory::PendingRequest* request =
+      WaitForRequest(first);
+  Redirect(*request, GURL("http://localhost/b.crx3"));
+  EXPECT_EQ(0u, Follows(*request));
+  request = WaitForRequest(second);
+  Respond(*request, "not a crx");
+  ASSERT_TRUE(base::test::RunUntil([&] { return results == 1; }));
+  task_environment_.RunUntilIdle();
+
+  EXPECT_EQ(1, results);
+  EXPECT_EQ(std::to_underlying(CrxDownloaderError::BAD_HASH), result.error);
+  const std::vector<CrxDownloader::DownloadMetrics> metrics =
+      downloader->download_metrics();
+  ASSERT_EQ(3u, metrics.size());
+  EXPECT_EQ(net::ERR_BLOCKED_BY_CLIENT, metrics[0].error);
+  EXPECT_EQ(first, metrics[1].url);
+  EXPECT_EQ(net::ERR_UNSAFE_REDIRECT, metrics[1].error);
+  EXPECT_EQ(second, metrics[2].url);
+  EXPECT_EQ(2u, loader_factory_.total_requests());
+}
