+        restricted ? base::BindRepeating(&TestDestinationAllowed)
+                   : AllowedDestinationPredicate());
+  }
+
+  void StartDownload(NetworkFetcher& fetcher, const GURL& url) {
+    fetcher.DownloadToFile(url, temp_dir_.GetPath().AppendASCII("download"),
+                           base::DoNothing(), base::DoNothing(),
+                           base::BindLambdaForTesting([&](int error, int64_t) {
+                             ++completions_;
+                             net_error_ = error;
+                           }));
+  }
+
+  void StartPost(NetworkFetcher& fetcher,
+                 const GURL& url,
+                 const std::string& body = "{}") {
+    fetcher.PostRequest(
+        url, body, "application/json", {}, base::DoNothing(), base::DoNothing(),
+        base::BindLambdaForTesting([&](std::optional<std::string>, int error,
+                                       const std::string&, const std::string&,
+                                       const std::string&, int64_t) {
+          ++completions_;
+          net_error_ = error;
+        }));
+  }
+
+  network::TestURLLoaderFactory::PendingRequest* WaitForRequest(
+      const GURL& url) {
+    network::TestURLLoaderFactory::PendingRequest* found = nullptr;
+    CHECK(base::test::RunUntil([&] {
+      for (auto& pending : *loader_factory_.pending_requests()) {
+        if (pending.request.url == url && pending.client.is_connected()) {
+          found = &pending;
+          return true;
+        }
+      }
+      return false;
+    }));
+    return found;
+  }
+
+  void Redirect(network::TestURLLoaderFactory::PendingRequest& request,
+                const GURL& to) {
+    net::RedirectInfo redirect;
+    redirect.new_url = to;
+    redirect.new_method = request.request.method;
+    redirect.status_code = net::HTTP_TEMPORARY_REDIRECT;
+    request.client->OnReceiveRedirect(
+        redirect, network::CreateURLResponseHead(net::HTTP_TEMPORARY_REDIRECT));
+    task_environment_.RunUntilIdle();
+  }
+
+  void Respond(network::TestURLLoaderFactory::PendingRequest& request,
+               std::string_view content) {
+    mojo::ScopedDataPipeProducerHandle producer;
+    mojo::ScopedDataPipeConsumerHandle consumer;
+    CHECK_EQ(MOJO_RESULT_OK,
+             mojo::CreateDataPipe(content.size(), producer, consumer));
+    CHECK_EQ(MOJO_RESULT_OK,
+             producer->WriteAllData(base::as_byte_span(content)));
+    producer.reset();
+    request.client->OnReceiveResponse(
+        network::CreateURLResponseHead(net::HTTP_OK), std::move(consumer),
+        std::nullopt);
+    network::URLLoaderCompletionStatus status(net::OK);
+    status.decoded_body_length = base::ByteSize(content.size());
+    request.client->OnComplete(status);
+  }
+
+  size_t Follows(const network::TestURLLoaderFactory::PendingRequest& request) {
+    return request.test_url_loader->follow_redirect_params().size();
+  }
+
+  base::test::TaskEnvironment task_environment_;
+  base::ScopedTempDir temp_dir_;
+  network::TestURLLoaderFactory loader_factory_;
+  scoped_refptr<network::SharedURLLoaderFactory> shared_url_loader_factory_;
+  int completions_ = 0;
+  int net_error_ = 1;
+};
