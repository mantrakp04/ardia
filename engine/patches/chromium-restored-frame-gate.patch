+
+namespace {
+
+constexpr int kArdiaPresentedFramesWanted = 2;
+constexpr base::TimeDelta kArdiaGateRetry = base::Milliseconds(50);
+constexpr base::TimeDelta kArdiaGateStalled = base::Milliseconds(500);
+
+class ArdiaRestoredFrameGate;
+
+std::set<ArdiaRestoredFrameGate*>& ArdiaRestoredFrameGates() {
+  static base::NoDestructor<std::set<ArdiaRestoredFrameGate*>> gates;
+  return *gates;
 }
+
+class ArdiaRestoredFrameGate : public WebContentsObserver,
+                               public RenderWidgetHostObserver,
+                               public RenderFrameMetadataProvider::Observer {
+ public:
+  ArdiaRestoredFrameGate(WebContents* contents,
+                         base::OnceCallback<void(const std::string&)> displayed)
+      : WebContentsObserver(contents), displayed_(std::move(displayed)) {
+    ArdiaRestoredFrameGates().insert(this);
+    Watch();
+  }
+
+  ~ArdiaRestoredFrameGate() override {
+    Unwatch();
+    ArdiaRestoredFrameGates().erase(this);
+  }
+
+  void LayerUpdated(RenderWidgetHostViewBase* view,
+                    const gfx::Size& pixel_size) {
+    if (finished_ || view != view_.get()) {
+      return;
+    }
+    layer_size_ = pixel_size;
+    if (!redrawing_) {
+      Check();
+      return;
+    }
+    MaybeFinish();
+  }
+
+  void RenderFrameHostChanged(RenderFrameHost* old_host,
+                              RenderFrameHost* new_host) override {
+    if (!finished_ && new_host && new_host->IsInPrimaryMainFrame()) {
+      Watch();
+    }
+  }
 
+  void PrimaryMainFrameRenderProcessGone(
+      base::TerminationStatus status) override {
+    Finish("the page's process is gone");
+  }
+
+  void WebContentsDestroyed() override {
+    if (!finished_) {
+      delete this;
+    }
+  }
+
+  void RenderWidgetHostDestroyed(RenderWidgetHost* widget_host) override {
+    Unwatch();
+  }
+
+  void OnRenderFrameMetadataChangedBeforeActivation(
+      const cc::RenderFrameMetadata& metadata) override {}
+  void OnRenderFrameMetadataChangedAfterActivation(
+      base::TimeTicks activation_time) override {
+    Check();
+  }
+  void OnRenderFrameSubmission() override {}
+  void OnLocalSurfaceIdChanged(const cc::RenderFrameMetadata& metadata) override {}
+
+ private:
+  void Watch() {
+    Unwatch();
+    RenderFrameHost* frame = web_contents()->GetPrimaryMainFrame();
+    auto* view = static_cast<RenderWidgetHostViewBase*>(frame->GetView());
+    if (!view || !view->host()) {
+      Finish("the page has no view");
+      return;
+    }
+    view_ = view->GetWeakPtr();
+    host_ = view->host();
+    host_->AddObserver(this);
+    host_->render_frame_metadata_provider()->AddObserver(this);
+    view->RequestRepaintOnNewSurface();
+    retry_.Start(FROM_HERE, kArdiaGateRetry, this,
+                 &ArdiaRestoredFrameGate::Retry);
+    Check();
+  }
+
+  void Unwatch() {
+    retry_.Stop();
+    weak_.InvalidateWeakPtrs();
+    redrawing_ = false;
+    laid_out_ = false;
+    asked_layout_ = false;
+    presented_ = 0;
+    layer_size_.reset();
+    if (host_) {
+      host_->render_frame_metadata_provider()->RemoveObserver(this);
+      host_->RemoveObserver(this);
+    }
+    host_ = nullptr;
+    view_ = nullptr;
+  }
+
+  void Retry() {
+    if (redrawing_ && base::TimeTicks::Now() - redraw_started_ > kArdiaGateStalled) {
+      VLOG(1) << "ardia: the restored frame's redraw stalled (presented "
+              << presented_ << "); asking again";
+      weak_.InvalidateWeakPtrs();
+      redrawing_ = false;
+      asked_layout_ = false;
+      presented_ = 0;
+    }
+    if (asked_layout_ &&
+        base::TimeTicks::Now() - asked_layout_at_ > kArdiaGateStalled) {
+      weak_.InvalidateWeakPtrs();
+      asked_layout_ = false;
+    }
+    Check();
+  }
+
+  void LaidOut(bool drawn) {
+    asked_layout_ = false;
+    if (drawn) {
+      laid_out_ = true;
+    }
+    Check();
+  }
+
+  void Check() {
+    if (finished_ || redrawing_ || !view_ || !host_) {
+      return;
+    }
+    const viz::LocalSurfaceId& surface = view_->GetLocalSurfaceId();
+    ui::Compositor* compositor = view_->GetCompositor();
+    if (!surface.is_valid() || !compositor || !view_->IsShowing()) {
+      return;
+    }
+    if (!laid_out_) {
+      if (!asked_layout_) {
+        asked_layout_ = true;
+        asked_layout_at_ = base::TimeTicks::Now();
+        web_contents()->GetPrimaryMainFrame()->InsertVisualStateCallback(
+            base::BindOnce(&ArdiaRestoredFrameGate::LaidOut,
+                           weak_.GetWeakPtr()));
+      }
+      return;
+    }
+    const cc::RenderFrameMetadata& metadata =
+        host_->render_frame_metadata_provider()->LastRenderFrameMetadata();
+    if (!metadata.local_surface_id ||
+        !metadata.local_surface_id->IsSameOrNewerThan(surface)) {
+      return;
+    }
+    surface_ = surface.ToString();
+    frame_size_ = metadata.viewport_size_in_pixels;
+    frame_ = base::StrCat(
+        {"frame ", metadata.local_surface_id->ToString(), " viewport ",
+         base::NumberToString(metadata.viewport_size_in_pixels.width()), "x",
+         base::NumberToString(metadata.viewport_size_in_pixels.height()),
+         " scale ", base::NumberToString(metadata.device_scale_factor)});
+    redrawing_ = true;
+    redraw_started_ = base::TimeTicks::Now();
+    RequestPresentation(compositor);
+  }
+
+  void RequestPresentation(ui::Compositor* compositor) {
+    compositor->RequestSuccessfulPresentationTimeForNextFrame(
+        base::BindOnce(&ArdiaRestoredFrameGate::Presented, weak_.GetWeakPtr()));
+    compositor->ScheduleFullRedraw();
+  }
+
+  void Presented(const viz::FrameTimingDetails& details) {
+    ++presented_;
+    ui::Compositor* compositor = view_ ? view_->GetCompositor() : nullptr;
+    if (presented_ < kArdiaPresentedFramesWanted && compositor) {
+      RequestPresentation(compositor);
+      return;
+    }
+    MaybeFinish();
+  }
+
+  bool LayerHasFrameSize() const {
+    return !layer_size_ ||
+           (std::abs(layer_size_->width() - frame_size_.width()) <= 2 &&
+            std::abs(layer_size_->height() - frame_size_.height()) <= 2);
+  }
+
+  void MaybeFinish() {
+    if (presented_ >= kArdiaPresentedFramesWanted && LayerHasFrameSize()) {
+      Finish(base::StrCat(
+          {"surface ", surface_, " ", frame_, " presented ",
+           base::NumberToString(presented_), " layer ",
+           layer_size_ ? layer_size_->ToString() : std::string("unchanged")}));
+    }
+  }
+
+  void Finish(const std::string& proof) {
+    if (finished_) {
+      return;
+    }
+    finished_ = true;
+    Unwatch();
+    Observe(nullptr);
+    std::move(displayed_).Run(proof);
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE, this);
+  }
+
+  base::OnceCallback<void(const std::string&)> displayed_;
+  base::WeakPtr<RenderWidgetHostViewBase> view_;
+  raw_ptr<RenderWidgetHostImpl> host_ = nullptr;
+  std::string surface_;
+  std::string frame_;
+  base::RepeatingTimer retry_;
+  base::TimeTicks redraw_started_;
+  base::TimeTicks asked_layout_at_;
+  gfx::Size frame_size_;
+  std::optional<gfx::Size> layer_size_;
+  bool laid_out_ = false;
+  bool asked_layout_ = false;
+  bool redrawing_ = false;
+  bool finished_ = false;
+  int presented_ = 0;
+  base::WeakPtrFactory<ArdiaRestoredFrameGate> weak_{this};
+};
+
+}  // namespace
+
+void ArdiaWhenRestoredFrameDisplayed(
+    WebContents* contents,
+    base::OnceCallback<void(const std::string&)> displayed) {
+  new ArdiaRestoredFrameGate(contents, std::move(displayed));
+}
+
+void ArdiaDisplayedLayerUpdated(RenderWidgetHostViewBase* view,
+                                const gfx::Size& pixel_size) {
+  if (ArdiaRestoredFrameGates().empty()) {
+    return;
+  }
+  std::vector<ArdiaRestoredFrameGate*> gates(ArdiaRestoredFrameGates().begin(),
+                                             ArdiaRestoredFrameGates().end());
+  for (ArdiaRestoredFrameGate* gate : gates) {
+    if (ArdiaRestoredFrameGates().contains(gate)) {
+      gate->LayerUpdated(view, pixel_size);
+    }
+  }
+}
+
 }  // namespace content
