 #include "base/apple/bundle_locations.h"
 #include "base/apple/foundation_util.h"
 #include "base/apple/scoped_cftyperef.h"
+#include "base/logging.h"
 #include "base/mac/mac_util.h"
 #include "base/strings/sys_string_conversions.h"
 #include "build/branding_buildflags.h"
@@ -53,9 +56,22 @@
   return [NSBundle bundleWithURL:default_app_url].bundleIdentifier;
 }
 
+bool ArdiaBackgroundInstanceRefuses(const char* change) {
+  const char* background = getenv("ARDIA_BACKGROUND");
+  if (!background || strcmp(background, "1")) {
+    return false;
+  }
+  LOG(WARNING) << "Ardia: background instance, not " << change;
+  return true;
+}
+
 }  // namespace
 
 bool SetAsDefaultBrowser() {
+  if (ArdiaBackgroundInstanceRefuses("setting the default browser")) {
+    return false;
+  }
+
   // We really do want the outer bundle here, not the main bundle since
   // setting a shortcut to Chrome as the default browser doesn't make sense.
   NSURL* app_bundle = base::apple::OuterBundleURL();
@@ -119,6 +135,10 @@ bool SetAsDefaultClientForScheme(const std::string& scheme) {
     return false;
   }
 
+  if (ArdiaBackgroundInstanceRefuses("setting a scheme handler")) {
+    return false;
+  }
+
   if (GetDefaultSchemeClientSetPermission() != SET_DEFAULT_UNATTENDED) {
     return false;
   }
