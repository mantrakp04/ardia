+bool ArdiaKeepsConnectedPagesLive() {
+  return kArdiaUnconnectedUnfreezeInterval.Get() >
+         features::kInfiniteTabsFreezing_UnfreezeInterval.Get();
+}
+
+bool ArdiaPageHasLiveConnection(const PageNode* page_node) {
+  if (!ArdiaKeepsConnectedPagesLive()) {
+    return false;
+  }
+  base::WeakPtr<content::WebContents> contents = page_node->GetWebContents();
+  if (!contents) {
+    return false;
+  }
+  bool live = false;
+  contents->GetPrimaryMainFrame()->ForEachRenderFrameHost(
+      [&live](content::RenderFrameHost* frame) {
+        live = live || content::ArdiaFrameHasLiveConnection(frame);
+      });
+  return live;
+}
+
+base::TimeDelta ArdiaUnfreezeInterval(bool has_live_connection) {
+  return ArdiaKeepsConnectedPagesLive() && !has_live_connection
+             ? kArdiaUnconnectedUnfreezeInterval.Get()
+             : features::kInfiniteTabsFreezing_UnfreezeInterval.Get();
+}
