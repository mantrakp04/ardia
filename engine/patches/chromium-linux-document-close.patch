+void RenderFrameHostImpl::StartLinuxBeforeUnloadDispatch() {
+  if (!is_waiting_for_beforeunload_completion_ ||
+      !linux_before_unload_request_) {
+    linux_before_unload_request_ =
+        std::make_shared<ardia::LinuxCloseDispatch>();
+    std::vector<std::pair<WeakDocumentPtr, uint64_t>> documents;
+    ForEachRenderFrameHostImpl([&documents](RenderFrameHostImpl* frame) {
+      documents.emplace_back(frame->GetWeakDocumentPtr(),
+                             frame->linux_before_unload_revision_);
+    });
+    linux_before_unload_request_->preflight_current = base::BindRepeating(
+        [](WeakDocumentPtr root,
+           const std::vector<std::pair<WeakDocumentPtr, uint64_t>>& documents) {
+          auto* host = root.AsRenderFrameHostIfValid();
+          if (!host) {
+            return false;
+          }
+          size_t index = 0;
+          bool current = true;
+          static_cast<RenderFrameHostImpl*>(host)->ForEachRenderFrameHostImpl(
+              [&documents, &index, &current](RenderFrameHostImpl* frame) {
+                if (index >= documents.size() ||
+                    documents[index].first.AsRenderFrameHostIfValid() != frame ||
+                    documents[index].second !=
+                        frame->linux_before_unload_revision_) {
+                  current = false;
+                }
+                ++index;
+              });
+          return current && index == documents.size();
+        },
+        GetWeakDocumentPtr(), std::move(documents));
+    linux_before_unload_request_->source_current = base::BindRepeating(
+        [](base::WeakPtr<RenderFrameHostImpl> frame,
+           std::weak_ptr<ardia::LinuxCloseDispatch> request) {
+          auto dispatch = request.lock();
+          return frame && dispatch &&
+                 frame->linux_before_unload_request_ == dispatch;
+        },
+        GetWeakPtr(),
+        std::weak_ptr<ardia::LinuxCloseDispatch>(linux_before_unload_request_));
+  }
+  ardia::AdoptLinuxCloseDispatch(linux_before_unload_request_);
