+void RenderFrameHostImpl::CompleteLinuxBeforeUnloadDispatch(
+    std::shared_ptr<ardia::LinuxCloseDispatch> dispatch,
+    bool proceed) {
+  if (dispatch && linux_before_unload_request_ != dispatch) {
+    ardia::CompleteLinuxCloseDispatch(dispatch);
+    return;
