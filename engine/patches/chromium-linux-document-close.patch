+void BrowserCloseManager::OnLinuxCloseReady(
+    base::WeakPtr<BrowserCloseManager> attempt,
+    base::WeakPtr<BrowserWindowInterface> browser,
+    bool proceed) {
+  if (!attempt || linux_cancelled_) {
+    return;
+  }
+  if (!proceed || !browser) {
+    CancelBrowserClose();
+    return;
+  }
+  if (browser_shutdown::ShouldIgnoreUnloadHandlers()) {
+    CloseBrowsers();
+  } else {
+    TryToCloseBrowsers();
+  }
+}
+
+void BrowserCloseManager::OnLinuxTeardownReady(
+    base::WeakPtr<BrowserCloseManager> attempt,
+    base::WeakPtr<BrowserWindowInterface> browser,
+    base::UnguessableToken token,
+    bool proceed) {
+  if (!browser) {
+    OnLinuxCloseReady(attempt, browser, false);
+    return;
+  }
+  if (token.is_empty() ||
+      ardia::CurrentLinuxCloseToken(browser.get()) != token) {
+    return;
+  }
+  if (!proceed) {
+    OnLinuxCloseReady(attempt, browser, false);
+    return;
+  }
+  if (ardia::CanCancelLinuxClose(browser.get())) {
+    if (attempt && !linux_cancelled_) {
+      UnloadController::From(browser.get())
+          ->set_force_skip_warning_user_on_close(false);
+      OnLinuxCloseReady(attempt, browser, true);
+    }
+    return;
+  }
+  UnloadController::From(browser.get())
+      ->set_force_skip_warning_user_on_close(true);
+  browser->GetTabStripModel()->CloseAllTabs();
+  if (!browser) {
+    if (attempt) {
+      CloseBrowsers();
+    }
+    return;
+  }
+  if (ardia::CurrentLinuxCloseToken(browser.get()) != token ||
+      ardia::CanCancelLinuxClose(browser.get())) {
+    return;
+  }
+  if (ardia::GateLinuxClose(
+          browser.get(), ardia::LinuxCloseStage::kDestroy,
+          base::BindOnce(&BrowserCloseManager::OnLinuxTeardownReady,
+                         base::RetainedRef(this), attempt, browser, token))) {
+    return;
+  }
+  if (!browser || ardia::CurrentLinuxCloseToken(browser.get()) != token ||
+      ardia::CanCancelLinuxClose(browser.get())) {
+    return;
+  }
+  BrowserManagerService::SynchronouslyDestroyBrowser(browser.get());
+  if (attempt) {
+    CloseBrowsers();
+  }
+}
