+  RenderWidgetHostImpl* widget_host =
+      target ? RenderWidgetHostImpl::From(target->GetRenderWidgetHost())
+             : nullptr;
+  if (!widget_host) {
+    if (ardia_drag_owned_ || drag_controller_.IsDragging()) {
