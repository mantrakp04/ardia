+
+void InputHandler::ArdiaEndOwnedDrag() {
+  base::WeakPtr<RenderWidgetHostImpl> source = std::move(ardia_drag_source_);
+  ardia_drag_source_.reset();
+  std::unique_ptr<DragController::DragState> state =
+      std::move(drag_controller_.drag_state_);
+  drag_controller_.initial_state_ = nullptr;
+  if (!source) {
+    return;
+  }
+  ++g_ardia_drags_ended[kArdiaDragEndOwnerGone];
+  const gfx::PointF at = state ? state->pos : gfx::PointF();
+  if (state && state->host) {
+    state->host->DragTargetDragLeave(at, at);
+  }
+  source->DragSourceEndedAt(at, at, ui::mojom::DragOperation::kNone,
+                            base::DoNothing());
+}
 
