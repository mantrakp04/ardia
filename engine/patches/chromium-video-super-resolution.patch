+#if BUILDFLAG(IS_MAC)
+bool CARendererLayerTree::UpscaleVideo(ardiacore::VideoUpscaler* upscaler,
+                                       bool allowed) {
+  std::vector<ardiacore::VideoUpscaleCandidate> candidates;
+  std::vector<ContentLayer*> layers;
+  if (allowed) {
+    for (auto& clip_layer : root_layer_.clip_and_sorting_layers_) {
+      for (auto& transform_layer : clip_layer.transform_layers_) {
+        if (!transform_layer.transform_.IsPositiveScaleOrTranslation()) {
+          continue;
+        }
+        for (auto& content_layer : transform_layer.content_layers_) {
+          if (!content_layer.io_surface_ || content_layer.cv_pixel_buffer_ ||
+              content_layer.type_ == CALayerType::kHDRCopier) {
+            continue;
+          }
+          ardiacore::VideoUpscaleCandidate candidate;
+          candidate.source = content_layer.io_surface_.get();
+          candidate.color_space = content_layer.io_surface_color_space_;
+          candidate.contents_rect = content_layer.contents_rect_;
+          candidate.target_size =
+              transform_layer.transform_.MapRect(content_layer.rect_).size();
+          candidate.protected_video_type = content_layer.protected_video_type_;
+          candidate.has_hdr_metadata =
+              content_layer.hdr_metadata_ != gfx::HDRMetadata();
+          candidates.push_back(std::move(candidate));
+          layers.push_back(&content_layer);
+        }
+      }
+    }
+  }
+  upscaler->Process(allowed, candidates);
+  bool pending = false;
+  for (size_t i = 0; i < candidates.size(); ++i) {
+    pending |= candidates[i].pending;
+    if (!candidates[i].output ||
+        candidates[i].output.get() == layers[i]->upscaled_io_surface_.get()) {
+      continue;
+    }
+    layers[i]->upscaled_io_surface_.reset(candidates[i].output.get(),
+                                          base::scoped_policy::RETAIN);
+    if (has_committed_) {
+      TRACE_EVENT_INSTANT0("gpu", "ArdiaVSR.LateSwap", TRACE_EVENT_SCOPE_THREAD);
+      layers[i]->CommitUpscaledToCA();
+    }
+  }
+  return pending && !has_committed_;
+}
