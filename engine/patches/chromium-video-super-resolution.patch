+    AVSampleBufferDisplayLayerEnqueueIOSurface(
+        av_layer_, ShownIOSurface(), ShownColorSpace(), hdr_metadata_);
+  } else if (type_ == CALayerType::kDefault) {
+    ca_layer_.contents = (__bridge id)ShownIOSurface();
+    ca_layer_.contentsRect = ShownContentsRect().ToCGRect();
+  }
+}
