+TEST_F(KeychainKeyProviderNoResetTest, StartOverMakesOneNewKey) {
+  base::OnceClosure start_over;
+  g_test_start_over = &start_over;
+  g_ardia_safe_storage_unreadable = &TestSafeStorageUnreadable;
+  ScriptedKeychain keychain;
+  keychain.QueueFind(base::unexpected(errSecItemNotFound));
+  std::unique_ptr<KeychainKeyProvider> provider = MakeProvider(&keychain);
+
+  KeyFuture future;
+  GetKey(*provider, future.GetCallback());
+  task_environment_.FastForwardBy(base::Seconds(10));
+
+  ASSERT_TRUE(start_over);
+  EXPECT_EQ(g_test_unreadable_status, errSecItemNotFound);
+  EXPECT_FALSE(future.IsReady());
+  EXPECT_EQ(on_failure_count_, 0);
+  EXPECT_EQ(keychain.find_count(), 4);
+  EXPECT_EQ(keychain.add_if_absent_count(), 0);
+
+  g_test_start_over_allowed = true;
+  std::move(start_over).Run();
+  auto& [tag, key] = future.Get();
+
+  ASSERT_TRUE(key.has_value());
+  EXPECT_FALSE(g_test_start_over_allowed);
+  EXPECT_EQ(keychain.find_count(), 5);
+  EXPECT_EQ(keychain.add_if_absent_count(), 1);
+  EXPECT_EQ(keychain.add_or_update_count(), 0);
+  EXPECT_EQ(keychain.item_update_count(), 0);
+  EXPECT_EQ(on_failure_count_, 0);
+}
