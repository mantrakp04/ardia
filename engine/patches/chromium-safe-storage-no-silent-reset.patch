+class ScriptedKeychain : public crypto::apple::FakeKeychainV2 {
+ public:
+  ScriptedKeychain() : FakeKeychainV2("test-access-group") {}
+
+  void QueueFind(base::expected<std::string, OSStatus> result) {
+    finds_.push_back(std::move(result));
+  }
+  void QueueAdd(OSStatus result) { adds_.push_back(result); }
+
+  base::expected<std::vector<uint8_t>, OSStatus> FindGenericPassword(
+      std::string_view service_name,
+      std::string_view account_name) override {
+    ++find_count_;
+    base::expected<std::string, OSStatus> result = finds_.front();
+    if (finds_.size() > 1) {
+      finds_.pop_front();
+    }
+    if (!result.has_value()) {
+      return base::unexpected(result.error());
+    }
+    return base::ToVector(base::as_byte_span(*result));
+  }
+
+  OSStatus AddGenericPasswordIfAbsent(
+      std::string_view service_name,
+      std::string_view account_name,
+      base::span<const uint8_t> password) override {
+    ++add_if_absent_count_;
+    OSStatus result = adds_.empty() ? noErr : adds_.front();
+    if (adds_.size() > 1) {
+      adds_.pop_front();
+    }
+    if (result == noErr) {
+      added_ = std::string(base::as_string_view(password));
+    }
+    return result;
+  }
+
+  OSStatus AddGenericPassword(std::string_view service_name,
+                              std::string_view account_name,
+                              base::span<const uint8_t> password) override {
+    ++add_or_update_count_;
+    return noErr;
+  }
+
+  OSStatus ItemUpdate(CFDictionaryRef query,
+                      CFDictionaryRef keychain_data) override {
+    ++item_update_count_;
+    return noErr;
+  }
+
+  int find_count() const { return find_count_; }
+  int add_if_absent_count() const { return add_if_absent_count_; }
+  int add_or_update_count() const { return add_or_update_count_; }
+  int item_update_count() const { return item_update_count_; }
+  const std::string& added() const { return added_; }
+
+ private:
+  std::deque<base::expected<std::string, OSStatus>> finds_;
+  std::deque<OSStatus> adds_;
+  int find_count_ = 0;
+  int add_if_absent_count_ = 0;
+  int add_or_update_count_ = 0;
+  int item_update_count_ = 0;
+  std::string added_;
+};
+
+bool g_test_key_may_be_created = false;
+bool g_test_start_over_allowed = false;
+base::OnceClosure* g_test_start_over = nullptr;
+int g_test_unreadable_status = noErr;
+
+bool TestKeyMayBeCreated() {
+  return g_test_key_may_be_created ||
+         std::exchange(g_test_start_over_allowed, false);
+}
+
+void TestSafeStorageUnreadable(int status, base::OnceClosure retry) {
+  g_test_unreadable_status = status;
+  *g_test_start_over = std::move(retry);
+}
+
+constexpr char kSecretA[] = "mock_password";
+
+using KeyFuture =
+    base::test::TestFuture<const std::string&,
+                           base::expected<Encryptor::Key, KeyProvider::KeyError>>;
+
+}
+
+class KeychainKeyProviderNoResetTest : public ::testing::Test {
+ protected:
+  void SetUp() override {
+    g_ardia_safe_storage_key_may_be_created = &TestKeyMayBeCreated;
+    g_test_key_may_be_created = false;
+    g_test_start_over_allowed = false;
+    g_test_unreadable_status = noErr;
+  }
+  void TearDown() override {
+    g_ardia_safe_storage_key_may_be_created = nullptr;
+    g_ardia_safe_storage_unreadable = nullptr;
+    g_test_start_over = nullptr;
+  }
+
+  std::unique_ptr<KeychainKeyProvider> MakeProvider(
+      crypto::apple::KeychainV2* keychain) {
+    return base::WrapUnique(new KeychainKeyProvider(
+        keychain, base::BindOnce([](int* count) { ++*count; },
+                                 &on_failure_count_)));
+  }
+
+  void GetKey(KeychainKeyProvider& provider,
+              KeyProvider::KeyCallback callback) {
+    provider.GetKey(std::move(callback));
+  }
+
+  static Encryptor::Key SecretAKey() {
+    const std::vector<uint8_t> bytes = {0xAF, 0x0F, 0x76, 0x2A, 0xAF, 0x6D,
+                                        0x7D, 0x11, 0x58, 0x1B, 0x7A, 0xA8,
+                                        0xCE, 0x72, 0x18, 0xDE};
+    return Encryptor::Key(bytes, mojom::Algorithm::kAES128CBC);
+  }
+
+  Encryptor::Key KeyFor(const std::string& secret) {
+    ScriptedKeychain keychain;
+    keychain.QueueFind(secret);
+    std::unique_ptr<KeychainKeyProvider> provider = MakeProvider(&keychain);
+    KeyFuture future;
+    GetKey(*provider, future.GetCallback());
+    auto [tag, key] = future.Take();
+    CHECK(key.has_value());
+    return std::move(*key);
+  }
+
+  base::test::TaskEnvironment task_environment_{
+      base::test::TaskEnvironment::MainThreadType::UI,
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+  int on_failure_count_ = 0;
+};
+
+TEST_F(KeychainKeyProviderNoResetTest, ExistingDataItemBrieflyMissing) {
+  ScriptedKeychain keychain;
+  keychain.QueueFind(base::unexpected(errSecItemNotFound));
+  keychain.QueueFind(kSecretA);
+  std::unique_ptr<KeychainKeyProvider> provider = MakeProvider(&keychain);
+
+  KeyFuture future;
+  GetKey(*provider, future.GetCallback());
+  auto& [tag, key] = future.Get();
+
+  ASSERT_TRUE(key.has_value());
+  EXPECT_EQ(*key, SecretAKey());
+  EXPECT_EQ(keychain.find_count(), 2);
+  EXPECT_EQ(keychain.add_if_absent_count(), 0);
+  EXPECT_EQ(keychain.add_or_update_count(), 0);
+  EXPECT_EQ(keychain.item_update_count(), 0);
+  EXPECT_EQ(on_failure_count_, 0);
+}
+
+TEST_F(KeychainKeyProviderNoResetTest, ExistingDataItemMissingFailsClosed) {
+  ScriptedKeychain keychain;
+  keychain.QueueFind(base::unexpected(errSecItemNotFound));
+  std::unique_ptr<KeychainKeyProvider> provider = MakeProvider(&keychain);
+
+  bool key_delivered = false;
+  GetKey(*provider, base::BindOnce(
+                        [](bool* delivered, const std::string&,
+                           base::expected<Encryptor::Key, KeyProvider::KeyError>) {
+                          *delivered = true;
+                        },
+                        &key_delivered));
+  task_environment_.FastForwardBy(base::Seconds(10));
+
+  EXPECT_FALSE(key_delivered);
+  EXPECT_EQ(on_failure_count_, 1);
+  EXPECT_EQ(keychain.find_count(), 4);
+  EXPECT_EQ(keychain.add_if_absent_count(), 0);
+  EXPECT_EQ(keychain.add_or_update_count(), 0);
+  EXPECT_EQ(keychain.item_update_count(), 0);
+}
+
+TEST_F(KeychainKeyProviderNoResetTest, FreshDirItemAppearsDuringAdd) {
