<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="no_backup/" />
        <exclude domain="root" path="app_webview/" />
        <exclude domain="file" path="System/" />
        <exclude domain="sharedpref" path="WebViewChromiumPrefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="no_backup/" />
        <exclude domain="root" path="app_webview/" />
        <exclude domain="file" path="System/" />
        <exclude domain="sharedpref" path="WebViewChromiumPrefs.xml" />
    </device-transfer>
</data-extraction-rules>
