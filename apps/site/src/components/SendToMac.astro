---
import { TESTFLIGHT, sentLink } from "../data/release";

interface Props {
  location: "hero" | "closing" | "release_notes";
  main?: boolean;
}
const { location, main = false } = Astro.props;
const email = `mailto:?subject=${encodeURIComponent("Ardia, for my Mac")}&body=${encodeURIComponent(
  `Open this on your Mac: ${sentLink("email")}`,
)}`;
---

<div class="send phone-only" id={main ? "send" : undefined} data-send-panel={main ? "main" : ""} data-location={location} data-meadow-keep-out="copy">
  <a class="btn send-main" href={email} data-send="main">
    <svg width="18" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true">
      <path d="M1.5 1.5h15v9h-15zM0 12.5h18" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
    </svg>
    Send to my Mac
  </a>
  <div class="send-more" data-meadow-keep-out="copy">
    <button type="button" class="send-link" data-send="share" hidden>Share</button>
    <button type="button" class="send-link" data-send="copy"><span data-copy-label aria-live="polite">Copy link</span></button>
    <a class="send-link" href={email} data-send="email">Email it to me</a>
  </div>
  <a
    class="btn nightly-btn testflight ios-only"
    href={TESTFLIGHT}
    rel="noopener"
    data-track="testflight_clicked"
    data-track-location={location}
  >
    <svg width="14" height="20" viewBox="0 0 14 20" fill="none" aria-hidden="true">
      <rect x="1" y="1" width="12" height="18" rx="2.5" stroke="currentColor" stroke-width="2"></rect>
      <path d="M5.5 15.5h3" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
    </svg>
    Get the iPhone app
    <span class="btn-meta">TestFlight</span>
  </a>
</div>

<style>
  .send {
    margin-top: 26px;
    scroll-margin-top: 84px;
  }
  .send-main {
    width: 100%;
    justify-content: center;
  }
  .send-more {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 24px;
    margin-top: 6px;
  }
  .send-link {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: var(--t-small);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
    cursor: pointer;
    touch-action: manipulation;
  }
  .testflight {
    width: 100%;
    justify-content: center;
    margin-top: 14px;
  }
  .send-link[hidden] {
    display: none;
  }
  .send[data-flash] .send-main {
    animation: flash 900ms var(--ease-out);
  }
  @keyframes flash {
    30% {
      transform: scale(1.03);
    }
  }
</style>
