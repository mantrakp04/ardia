---
import type { ImageMetadata } from "astro";
import { Picture, getImage } from "astro:assets";

interface Props {
  src: ImageMetadata | ImageMetadata[];
  alt: string;
  sizes: string;
  panel?: boolean;
  eager?: boolean;
}
const { src, alt, sizes, panel = false, eager = false } = Astro.props;
const shots = Array.isArray(src) ? src : [src];
const first = shots[0];
const fan = shots.length > 1;
const full = await Promise.all(shots.map((s) => getImage({ src: s, format: "webp", width: Math.min(s.width, 2880) })));
const name = first.src.split("/").pop()?.split(".")[0]?.split("_")[0] ?? "shot";
const widths = (s: ImageMetadata) => [640, 960, 1280, 1600, 1920, 2200, s.width].filter((w, i, a) => w <= s.width && a.indexOf(w) === i);
---

<div
  class:list={["shot", { panel, fan }]}
  style={`--n: ${shots.length}; aspect-ratio: ${first.width} / ${first.height}`}
  role={fan ? "img" : undefined}
  aria-label={fan ? alt : undefined}
>
  {
    shots.map((s, i) => (
      <Picture
        src={s}
        alt={fan ? "" : alt}
        formats={["avif"]}
        fallbackFormat="webp"
        widths={widths(s)}
        sizes={sizes}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        style={`--i: ${i}`}
      />
    ))
  }
  <button
    class="zoom-hit"
    type="button"
    aria-label="Enlarge screenshot"
    data-lightbox={JSON.stringify(full.map((f, i) => ({ src: f.src, w: shots[i].width, h: shots[i].height })))}
    data-lightbox-alt={alt}
    data-track="screenshot_opened"
    data-track-shot={name}
  ></button>
</div>

<style>
  .zoom-hit {
    position: absolute;
    inset: 0;
    z-index: 2;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }
  .zoom-hit:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }
  .shot {
    position: relative;
    width: 100%;
  }
  .shot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 1px 1px rgb(22 19 15 / 0.14)) drop-shadow(0 22px 44px rgb(22 19 15 / 0.2));
  }
  .panel :global(img) {
    border-radius: 12px;
  }
  .fan {
    --step: 10%;
  }
  .fan :global(picture) {
    position: absolute;
    inset: 0;
  }
  .fan :global(img) {
    position: absolute;
    top: calc(var(--i) * var(--step) * 0.62);
    left: calc(var(--i) * var(--step));
    width: calc(100% - (var(--n) - 1) * var(--step));
    height: auto;
  }
</style>
