---
import type { ImageMetadata } from "astro";
import { Picture, getImage } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
}
const { src, alt, sizes } = Astro.props;
const full = await getImage({ src, format: "webp", width: Math.min(src.width, 2880) });
const name = src.src.split("/").pop()?.split(".")[0]?.split("_")[0] ?? "shot";
const widths = [640, 960, 1280, 1600, 1920, 2200, src.width].filter((w, i, a) => w <= src.width && a.indexOf(w) === i);
---

<div class="shot" style={`aspect-ratio: ${src.width} / ${src.height}`}>
  <Picture src={src} alt={alt} formats={["avif"]} fallbackFormat="webp" widths={widths} sizes={sizes} loading="lazy" decoding="async" />
  <button
    class="zoom-hit"
    type="button"
    aria-label="Enlarge screenshot"
    data-lightbox={JSON.stringify([{ src: full.src, w: src.width, h: src.height }])}
    data-lightbox-alt={alt}
    data-track="screenshot_opened"
    data-track-shot={name}
  ></button>
</div>

<style>
  .zoom-hit {
    position: absolute;
    inset: 0;
    z-index: 2;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }
  .zoom-hit:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }
  .shot {
    position: relative;
    width: 100%;
  }
  .shot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 1px 1px rgb(22 19 15 / 0.14)) drop-shadow(0 22px 44px rgb(22 19 15 / 0.2));
  }
</style>
