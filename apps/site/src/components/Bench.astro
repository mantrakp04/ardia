---
import { base } from "../data/site";
import { bench, display, BENCH_METHOD, type Figure } from "../data/bench";
import { scorecardOf } from "../data/benchScorecard";

interface Props {
  page?: boolean;
}
const { page = false } = Astro.props;
const Title = page ? "h1" : "h2";
const CardTitle = page ? "h2" : "h3";

const card = bench ? scorecardOf(bench) : null;
const rivals = bench?.rivals ?? [];
const named = rivals.length > 1 ? `${rivals.slice(0, -1).join(", ")} and ${rivals[rivals.length - 1]}` : (rivals[0] ?? "");
const listOf = (items: string[]) =>
  items.length > 1 ? `${items.slice(0, -1).join(", ")} and ${items[items.length - 1]}` : (items[0] ?? "");

const takers = card ? card.takenBy.map((t) => (card.takenBy.length > 1 ? `${t.name} ${t.count}` : t.name)) : [];
const lede = card
  ? [
      `Ardia against ${named}: ${card.total} tests, same Mac, every release.`,
      card.losses
        ? `${listOf(takers)} ${card.takenBy.length > 1 ? "take the rest" : `takes ${card.losses === 1 ? "one" : card.losses}`}. They’re in here too.`
        : "No asterisks.",
    ].join(" ")
  : "";

const countAttrs = (f: Figure) => ({
  "data-bench-count": "",
  "data-bench-value": String(f.value),
  "data-bench-decimals": String(f.decimals),
  "data-bench-from": String(f.from),
});
const unitText = (unit: string) => (unit === "%" ? "%" : ` ${unit}`);
const tick = "M3 13.5c2.2 1.4 4.3 3.6 6.4 6.6C13 13 17.6 7.4 25 2.6";
---

{
  bench && card && (
    <section class:list={["bb paint", { edge: !page, "bb-page": page }]} id="speed" aria-labelledby="bench-title" data-shot="bench" data-bench>
      <div class="wrap">
        <header class="bb-head">
          <div class="bb-title">
            <p class="label kicker">Measured before every release</p>
            <Title class="poster bb-heading" id="bench-title" data-reveal>
              {page && <span class="visually-hidden">Ardia vs Dia vs Helium: </span>}Benchmarks.
            </Title>
            <p class="lede" data-reveal style="--i: 1">
              {lede}
            </p>
            {bench.sample && <p class="label sample">Sample numbers. Not measured. Dev only.</p>}
          </div>

        </header>

        <ul class="cards" role="list">
          {card.cards.map((c) => (
            <li class:list={["card", c.outcome, { wide: c.wide, solo: c.solo }]} data-bench-land>
              <div class="card-top">
                <CardTitle class="card-title">{c.title}</CardTitle>
                {c.wide ? (
                  <p class:list={["label", "record", { mixed: c.record.won < c.record.of }]}>
                    {c.stamp}
                  </p>
                ) : c.outcome === "win" ? (
                  <svg class="tick" viewBox="0 0 28 24" width="24" height="21" role="img" aria-label="Ardia wins">
                    <path d={tick} />
                  </svg>
                ) : (
                  <p class="label stamp">{c.stamp}</p>
                )}
              </div>

              <div class="card-body">
                <div class="call">
                  {c.context && <p class="label context">{c.context}</p>}
                  <p class="verdict poster">
                    {c.verdict.figure ? (
                      <span class="fig">
                        <span {...countAttrs(c.verdict.figure)}>{display(c.verdict.figure)}</span>
                        {c.verdict.figure.suffix}
                      </span>
                    ) : (
                      <span class="fig">Tie</span>
                    )}
                    {c.verdict.photoFinish && c.verdict.figure && <span class="label photo">Photo finish</span>}
                  </p>
                  <p class="line">{c.verdict.line}</p>
                  {c.verdict.note && <p class="note">{c.verdict.note}</p>}
                </div>

                {c.wide ? (
                  <table class="sheet">
                    <caption class="visually-hidden">{c.caption}</caption>
                    <thead>
                      <tr>
                        <th scope="col" class="label unit">
                          {c.unit}
                        </th>
                        {card.roster.map((name, j) => (
                          <th scope="col" class:list={["label", { us: j === 0 }]}>
                            {name}
                          </th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {c.cases.map((k) => (
                        <tr>
                          <th scope="row" title={k.fullLabel}>
                            {k.label}
                          </th>
                          {k.lanes.map((l, j) =>
                            l.bar ? (
                              <td
                                class:list={{ us: l.isArdia, best: l.bar.isBest }}
                                style={`--w: ${l.bar.share.toFixed(4)}; --j: ${j}`}
                              >
                                <span class="num">{display(l.bar.value)}</span>
                                {l.bar.isBest && <span class="visually-hidden"> (best)</span>}
                                <span class="dash" aria-hidden="true" />
                              </td>
                            ) : (
                              <td class="none">
                                <span aria-hidden="true">–</span>
                                <span class="visually-hidden">not measured</span>
                              </td>
                            ),
                          )}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                ) : (
                  <>
                    <div class="lanes" aria-hidden="true">
                      {c.cases[0].lanes.map((l, j) => (
                        <div
                          class:list={["lane", { us: l.isArdia, best: l.bar?.isBest, empty: !l.bar }]}
                          style={`--w: ${(l.bar?.share ?? 0).toFixed(4)}; --j: ${j}`}
                        >
                          <span class="lane-name">{l.name}</span>
                          <span class="lane-val label">
                            {l.bar ? `${display(l.bar.value)}${unitText(l.bar.unit)}` : "not measured"}
                          </span>
                          <span class="lane-track">
                            <span class="lane-bar" />
                          </span>
                        </div>
                      ))}
                    </div>
                    <div class="visually-hidden">
                      <table>
                        <caption>{c.caption}</caption>
                        <thead>
                          <tr>
                            <th scope="col">Browser</th>
                            <th scope="col">Median</th>
                          </tr>
                        </thead>
                        <tbody>
                          {c.cases[0].lanes.map((l) => (
                            <tr>
                              <th scope="row">{l.bar?.isBest ? `${l.name} (best)` : l.name}</th>
                              <td>{l.bar ? `${display(l.bar.value)}${unitText(l.bar.unit)}` : "not measured"}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </>
                )}
              </div>

              {c.wide && (
                <div class="card-foot">
                  <p class="label meta">{c.meta}</p>
                  {c.footnotes.map((f) => (
                    <p class="foot">{f}</p>
                  ))}
                </div>
              )}
            </li>
          ))}
          <li class="colophon" data-bench-land>
            <p class="label colophon-title">The small print</p>
            <p>
              {bench.machine}, {bench.date}. {bench.versions}.
            </p>
            <p>Every figure is a median, so one lucky run doesn’t count.</p>
            <a
              class="link label"
              href={BENCH_METHOD}
              rel="noopener"
              data-track="github_clicked"
              data-track-link="bench_method"
              data-track-location="bench">How we measure</a
            >
            {!page && (
              <a class="link label" href={`${base}/benchmarks/`}>
                The benchmarks page
              </a>
            )}
          </li>
        </ul>
      </div>
    </section>
  )
}

<style>
  :global(#demo) ~ .bb {
    margin-top: calc(var(--edge) + clamp(32px, 4vw, 64px));
  }
  .bb {
    --bg: var(--golden);
    --wash: linear-gradient(180deg, #f0c983 0%, var(--golden) 40%, var(--golden-late) 100%);
    --bg-top: #f0c983;
    --dab: var(--forest);
    --ink-2: #3a372f;
    --muted: #8c6a4c;
    --card: #faf2df;
    --card-edge: rgb(22 19 15 / 0.82);
    --radius: 7px 12px 8px 14px / 11px 7px 13px 8px;
    padding: var(--section) 0 clamp(72px, 9vw, 140px);
  }

  .bb-page {
    padding-top: clamp(40px, 5vw, 88px);
  }
  .bb-head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    align-items: end;
    margin-bottom: clamp(32px, 4.4vw, 64px);
  }
  .bb-title {
    grid-column: 1 / span 7;
  }
  .bb-heading {
    font-size: var(--t-h2);
  }
  .lede {
    margin-top: clamp(18px, 2vw, 28px);
    max-width: 30em;
    font-size: var(--t-body);
    line-height: 1.5;
    color: var(--ink-2);
  }
  .sample {
    display: inline-block;
    margin-top: 20px;
    padding: 4px 10px;
    color: var(--stamp);
    border: 1.5px solid currentColor;
    border-radius: 3px;
    transform: rotate(-1.5deg);
  }

  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-flow: row dense;
    gap: clamp(10px, 1.3vw, 18px);
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(14px, 1.4vw, 20px);
    border: 1.5px solid var(--card-edge);
    border-radius: var(--radius);
    background-color: var(--card);
    background-image: var(--impasto-soft);
    background-size: 520px;
    background-blend-mode: soft-light;
    box-shadow: 0 16px 28px -22px rgb(90 50 20 / 0.55);
  }
  .card.wide {
    grid-column: span 2;
  }
  .card.loss,
  .card.tie {
    background: transparent;
    box-shadow: none;
  }

  .card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }
  .card-title {
    font-family: var(--poster);
    font-weight: 740;
    font-stretch: 85%;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 0.98rem;
    line-height: 1.15;
    text-wrap: balance;
  }
  .tick {
    flex: none;
    overflow: visible;
    margin-top: -2px;
  }
  .tick path {
    fill: none;
    stroke: var(--forest);
    stroke-width: 3.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .stamp {
    flex: none;
    max-width: 9em;
    padding: 3px 7px;
    border: 1.5px solid currentColor;
    border-radius: 3px;
    color: var(--stamp);
    font-weight: 600;
    line-height: 1.25;
    text-align: center;
    transform: rotate(3deg);
  }
  .record {
    flex: none;
    padding: 3px 8px;
    border-radius: 3px;
    background: var(--forest);
    color: var(--paper);
    font-weight: 560;
    white-space: nowrap;
  }
  .record.mixed {
    background: var(--ink);
  }

  .card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .call {
    margin-top: clamp(12px, 1.4vw, 20px);
  }
  .context {
    color: var(--ink-2);
    margin-bottom: 4px;
  }
  .verdict {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: clamp(3.4rem, 1.4rem + 4.2vw, 6.2rem);
    line-height: 0.82;
    color: var(--forest-deep);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .loss .verdict,
  .tie .verdict {
    color: var(--ink);
  }
  .photo {
    align-self: center;
    padding: 3px 6px;
    border: 1.5px solid currentColor;
    border-radius: 3px;
    font-size: 0.6rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--stamp);
    white-space: normal;
    max-width: 6em;
    text-align: center;
    transform: rotate(-4deg);
  }
  .line {
    margin-top: 10px;
    font-size: 1.04rem;
    font-weight: 560;
    line-height: 1.2;
  }
  .note {
    margin-top: 4px;
    font-size: 0.86rem;
    line-height: 1.3;
    color: var(--ink-2);
  }

  .lanes {
    margin-top: auto;
    padding-top: clamp(16px, 1.8vw, 24px);
    display: grid;
    row-gap: 8px;
  }
  .lane {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    column-gap: 8px;
    row-gap: 3px;
  }
  .lane-name {
    font-family: var(--poster);
    font-weight: 700;
    font-stretch: 85%;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 0.8rem;
    line-height: 1.1;
    color: var(--ink-2);
  }
  .lane.us .lane-name {
    color: var(--forest-deep);
    font-weight: 900;
  }
  .lane-val {
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .lane.best .lane-val {
    color: var(--ink);
    font-weight: 640;
  }
  .lane.empty .lane-val {
    color: var(--muted);
  }
  .lane-track {
    grid-column: 1 / -1;
    display: block;
    height: 9px;
  }
  .lane-bar {
    display: block;
    width: max(4px, calc(100% * var(--w)));
    height: 100%;
    border-radius: 3px 6px 4px 7px / 5px 3px 6px 4px;
    background-color: var(--muted);
    background-image: var(--impasto);
    background-size: 200px;
    background-blend-mode: soft-light;
    transform-origin: left center;
  }
  .lane.us .lane-bar {
    background-color: var(--forest);
  }
  .lane.empty .lane-track {
    border-top: 1.5px dashed rgb(22 19 15 / 0.28);
    height: 0;
    margin-top: 4px;
  }
  .lane.empty .lane-bar {
    display: none;
  }

  .card.wide .card-body {
    flex: none;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    column-gap: clamp(16px, 2vw, 28px);
    align-items: start;
  }
  .card.wide .verdict {
    font-size: clamp(3.8rem, 1.4rem + 5vw, 7.4rem);
  }
  .sheet {
    width: 100%;
    margin-top: clamp(16px, 1.8vw, 24px);
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .sheet th,
  .sheet td {
    padding: 6px 0 6px 8px;
    text-align: right;
    vertical-align: baseline;
  }
  .sheet th:first-child {
    padding-left: 0;
    text-align: left;
  }
  .sheet thead th {
    padding-bottom: 6px;
    border-bottom: 1.5px solid var(--ink);
    color: var(--ink-2);
    font-weight: 560;
  }
  .sheet thead th.us {
    color: var(--forest-deep);
    font-weight: 700;
  }
  .sheet thead .unit {
    text-transform: none;
  }
  .sheet tbody tr + tr {
    border-top: 1px solid var(--rule);
  }
  .sheet tbody th {
    font-size: 0.86rem;
    font-weight: 520;
    line-height: 1.2;
  }
  .sheet td {
    position: relative;
    font-family: var(--mono);
    font-stretch: 87.5%;
    font-size: 0.78rem;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .sheet td.best .num {
    color: var(--ink);
    font-weight: 700;
  }
  .sheet td.best.us .num {
    color: var(--forest-deep);
  }
  .sheet td.none {
    color: var(--muted);
  }
  .dash {
    position: absolute;
    right: 0;
    bottom: 2px;
    width: calc((100% - 8px) * var(--w));
    height: 3px;
    border-radius: 2px;
    background: rgb(22 19 15 / 0.22);
    transform-origin: right center;
  }
  .best .dash {
    background: var(--ink);
  }
  .best.us .dash {
    background: var(--forest);
  }

  .card-foot {
    margin-top: auto;
    padding-top: 14px;
  }
  .meta {
    color: var(--ink-2);
  }
  .foot {
    margin-top: 8px;
    padding-left: 10px;
    border-left: 2px solid var(--stamp);
    font-size: 0.86rem;
    line-height: 1.3;
  }

  .colophon {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: clamp(14px, 1.4vw, 20px) 2px;
    border-top: 1.5px solid var(--ink);
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--ink-2);
  }
  .colophon-title {
    color: var(--ink);
  }
  .colophon .link {
    margin-top: auto;
    align-self: flex-start;
    color: var(--ink);
    font-weight: 600;
  }
  .colophon .link + .link {
    margin-top: 0;
  }
  .colophon .link::after {
    content: " →";
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .bb [data-bench-land] {
      transition:
        opacity 320ms var(--ease-out) var(--d, 0ms),
        transform 520ms cubic-bezier(0.2, 1.2, 0.3, 1) var(--d, 0ms);
    }
    :global(.js) .bb [data-bench-land]:not(.landed) {
      opacity: 0;
      transform: translateY(22px) rotate(-0.6deg);
    }
    :global(.js) .bb .lane-bar,
    :global(.js) .bb .dash {
      transition: transform 620ms var(--ease-out) calc(var(--d, 0ms) + 160ms + var(--j, 0) * 70ms);
    }
    :global(.js) .bb [data-bench-land]:not(.landed) :is(.lane-bar, .dash) {
      transform: scaleX(0);
    }
  }

  @media (max-width: 1100px) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 860px) {
    .bb-title {
      grid-column: 1 / -1;
    }
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .card.wide .card-body {
      display: flex;
    }
    .card.solo {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 600px) {
    .bb {
      --radius: 5px 9px 6px 10px / 8px 5px 9px 6px;
    }
    .cards {
      gap: 8px;
    }
    .card {
      padding: 12px;
    }
    .card-title {
      font-size: 0.78rem;
    }
    .card-top {
      gap: 6px;
    }
    .tick {
      width: 18px;
      height: 16px;
    }
    .stamp {
      font-size: 0.56rem;
      padding: 2px 5px;
      max-width: 7.5em;
    }
    .verdict {
      font-size: clamp(2.7rem, 1.4rem + 6vw, 3.4rem);
    }
    .card.wide .call {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 14px;
      align-items: end;
    }
    .card.wide .context {
      grid-column: 1 / -1;
    }
    .card.wide .verdict {
      grid-row: span 2;
      font-size: clamp(3.4rem, 2rem + 8vw, 4.6rem);
    }
    .card.wide .line {
      margin-top: 0;
    }
    .photo {
      font-size: 0.5rem;
      padding: 2px 4px;
    }
    .line {
      margin-top: 8px;
      font-size: 0.88rem;
    }
    .note {
      font-size: 0.76rem;
    }
    .lanes {
      padding-top: 14px;
      row-gap: 6px;
    }
    .lane-name {
      font-size: 0.7rem;
    }
    .lane-val {
      font-size: 0.62rem;
    }
    .lane-track {
      height: 7px;
    }
    .sheet tbody th {
      font-size: 0.8rem;
    }
    .sheet td {
      font-size: 0.72rem;
    }
    .colophon {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-bench]");
  if (root) {
    const targets = [...root.querySelectorAll<HTMLElement>("[data-bench-land]")];
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const format = (v: number, decimals: number) =>
      v.toLocaleString("en-US", { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
    const ease = (t: number) => 1 - Math.pow(1 - t, 4);

    const count = (el: HTMLElement, delay: number) => {
      const to = Number(el.dataset.benchValue);
      const from = Number(el.dataset.benchFrom);
      const decimals = Number(el.dataset.benchDecimals);
      el.textContent = format(from, decimals);
      const start = performance.now() + delay;
      const step = (now: number) => {
        const t = Math.min(1, Math.max(0, (now - start) / 700));
        el.textContent = format(t >= 1 ? to : from + (to - from) * ease(t), decimals);
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    const land = (el: HTMLElement, delay: number) => {
      el.style.setProperty("--d", `${delay}ms`);
      el.classList.add("landed");
      for (const n of el.querySelectorAll<HTMLElement>("[data-bench-count]")) count(n, delay + 120);
    };

    if (still || !("IntersectionObserver" in window)) {
      for (const el of targets) el.classList.add("landed");
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          const arriving = entries.filter((e) => e.isIntersecting).map((e) => e.target as HTMLElement);
          arriving.forEach((el, i) => {
            io.unobserve(el);
            land(el, Math.min(i, 5) * 60);
          });
        },
        { threshold: 0.15, rootMargin: "0px 0px -6% 0px" },
      );
      for (const el of targets) io.observe(el);
    }
  }
</script>
