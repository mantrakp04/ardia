---
import { computerUse as cu } from "../data/computerUse";

interface Props {
  page?: boolean;
}
const { page = false } = Astro.props;

const tick = "M3 13.5c2.2 1.4 4.3 3.6 6.4 6.6C13 13 17.6 7.4 25 2.6";
const charts = [
  { key: "time", title: "Time", unit: "seconds" },
  { key: "tokens", title: "Tokens", unit: "tokens" },
] as const;
const quips: Record<string, string> = {
  sol: "Not close.",
  opus: "Closer race. Still a W.",
};
const rivalCopy: Record<string, string> = {
  sol: "faster than Aside at its best, window in front",
  opus: "faster than Aside with its memory of the app",
};
---

<section
  class:list={["cu paint", { edge: !page, "cu-page": page }]}
  id="computer-use"
  aria-labelledby="cu-title"
  data-shot="computer-use"
>
  <div class="wrap">
    <header class="cu-head">
      <div class="cu-title">
        <p class="label kicker">Bring your own agent</p>
        <h2 class="poster cu-heading" id="cu-title" data-reveal>Computer use.</h2>
      </div>
      <div class="cu-cmd" data-reveal style="--i: 1">
        <p class="label cmd-label">Your agent’s first move</p>
        <pre class="cmd"><code><span class="prompt" aria-hidden="true">$ </span>ardia browse snapshot -i</code></pre>
        <p class="cmd-note">How Claude Code or Codex starts driving a hidden, logged-in Ardia. Nothing in Ardia calls a model.</p>
      </div>
    </header>

    <ul class="cards" role="list">
      {
        cu.matchups.map((m) => (
          <li class="card" data-reveal>
            <div class="card-top">
              <h3 class="card-title">{m.model}</h3>
              <svg class="tick" viewBox="0 0 28 24" width="24" height="21" role="img" aria-label="Ardia wins">
                <path d={tick} />
              </svg>
            </div>
            <div class="call">
              <p class="verdict poster">{m.faster}</p>
              <div class="call-words">
                <p class="line">{rivalCopy[m.id]}</p>
                <p class="note">
                  {m.fewer} fewer tokens. {quips[m.id]}
                </p>
              </div>
            </div>
            <p class="label cold">
              Cold, no site notes: {m.cold.faster} faster, {m.cold.fewer} fewer tokens
            </p>
            <div class="charts">
              {charts.map((c) => (
                <div class="chart">
                  <p class="label chart-title">
                    {c.title}
                    <span class="chart-dir">lower is better</span>
                  </p>
                  <div class="lanes" aria-hidden="true">
                    {m.lanes.map((l) => (
                      <div class:list={["lane", { us: l.isArdia, pick: l.isPick }]} style={`--w: ${l[c.key].share.toFixed(4)}`}>
                        <span class="lane-name">
                          {l.agent}
                          <span class="lane-mode">{l.mode}</span>
                        </span>
                        <span class="lane-val label">{l[c.key].text}</span>
                        <span class="lane-track">
                          <span class="lane-bar" />
                        </span>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
            <div class="visually-hidden">
              <table>
                <caption>
                  {m.model}: median time and tokens to finish the calendar task, lower is better
                </caption>
                <thead>
                  <tr>
                    <th scope="col">Agent</th>
                    <th scope="col">Mode</th>
                    <th scope="col">Runs</th>
                    <th scope="col">Time</th>
                    <th scope="col">Tokens</th>
                  </tr>
                </thead>
                <tbody>
                  {m.lanes.map((l) => (
                    <tr>
                      <th scope="row">{l.agent}</th>
                      <td>{l.mode}</td>
                      <td>{l.runs}</td>
                      <td>{l.time.text}</td>
                      <td>{l.tokens.text}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="label meta">Medians · runs per row, top down: {m.lanes.map((l) => l.runs).join(", ")}</p>
          </li>
        ))
      }

      <li class="card fresh" data-reveal>
        <div class="card-top">
          <h3 class="card-title">Also handles: a task it never saw</h3>
          <p class="label stamp">No Aside run</p>
        </div>
        <div class="fresh-body">
          <div class="fresh-copy">
            <p class="line">{cu.fresh.title}. One cold run per agent.</p>
            <ul class="traps" role="list" aria-label="What’s in the way">
              {cu.fresh.traps.map((t) => <li class="label trap">{t}</li>)}
            </ul>
          </div>
          <table class="sheet">
            <caption class="visually-hidden">The expense report task, one cold run per agent</caption>
            <thead>
              <tr>
                <th scope="col" class="label">Agent</th>
                <th scope="col" class="label">Checks</th>
                <th scope="col" class="label">Time</th>
                <th scope="col" class="label">Tokens</th>
              </tr>
            </thead>
            <tbody>
              {
                cu.fresh.runs.map((r) => (
                  <tr>
                    <th scope="row">
                      {r.agent}
                      <span class="sheet-model">{r.model}</span>
                    </th>
                    <td class="pass">{r.result}</td>
                    <td>{r.time}</td>
                    <td>{r.tokens}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </li>

      <li class="colophon">
        <p class="label colophon-title">The small print</p>
        <ul class="fine" role="list">
          <li>
            Medians from {cu.dates}, high effort throughout, every run 5/5. The task is {cu.task.source}.
          </li>
          <li>Ardia ran hidden every time. Aside’s best numbers needed its window in front; hidden, its screenshots stall.</li>
          <li>Aside’s Opus runs had its memory of the app. Ardia’s cold runs started from nothing.</li>
          <li>Aside’s clock starts when the prompt is sent. Ardia’s includes booting the agent’s CLI.</li>
          <li>
            We tuned the <code>ardia</code> command on this calendar, so it’s home turf. The fairer test is a fresh task, and the
            expense report is that.
          </li>
          {
            cu.extras.map((x) => (
              <li>
                {x.agent} on {x.model}, {x.mode}: {x.time}, {x.tokens} tokens ({x.runs} runs). No Ardia run to set it against.
              </li>
            ))
          }
          <li>Only Aside’s in-browser agent was tested, not its separate desktop Computer Use.</li>
        </ul>
      </li>
    </ul>
  </div>
</section>

<style>
  :global(#demo) + .cu {
    margin-top: calc(var(--edge) + clamp(32px, 4vw, 64px));
  }
  .cu {
    --bg: var(--noon);
    --bg-top: #f3e9d6;
    --wash: linear-gradient(180deg, #f3e9d6 0%, var(--noon) 45%, #f0c983 100%);
    --dab: var(--forest);
    --ink-2: #3a372f;
    --muted: #a88a68;
    --card: #fbf5e8;
    --card-edge: rgb(22 19 15 / 0.82);
    --radius: 7px 12px 8px 14px / 11px 7px 13px 8px;
    padding: var(--section) 0 clamp(72px, 9vw, 140px);
  }
  .cu + :global(.bb.edge) {
    padding-top: clamp(56px, 6vw, 112px);
  }
  .cu-page {
    padding-top: clamp(40px, 5vw, 88px);
  }
  .cu-head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 28px;
    align-items: end;
    margin-bottom: clamp(28px, 3.6vw, 52px);
  }
  .cu-title {
    grid-column: 1 / span 7;
  }
  .cu-heading {
    font-size: var(--t-h2);
  }
  code {
    font-family: var(--mono);
    font-size: 0.86em;
    font-stretch: 87.5%;
  }
  .cu-cmd {
    grid-column: 9 / -1;
    min-width: 0;
  }
  .cmd-label {
    color: var(--ink-2);
    margin-bottom: 8px;
  }
  .cmd {
    margin: 0;
    padding: 14px 16px;
    border-radius: 4px;
    background: var(--ink);
    color: var(--paper);
    overflow-x: auto;
    box-shadow:
      0 1px 2px rgb(22 19 15 / 0.2),
      0 10px 22px -10px rgb(22 19 15 / 0.45);
  }
  .cmd code {
    font-size: clamp(0.78rem, 0.74rem + 0.2vw, 0.9rem);
    white-space: pre;
  }
  .prompt {
    color: var(--sun-pale);
  }
  .cmd-note {
    margin-top: 10px;
    font-size: var(--t-small);
    line-height: 1.4;
    color: var(--ink-2);
  }

  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(10px, 1.3vw, 18px);
  }
  .card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(14px, 1.6vw, 22px);
    border: 1.5px solid var(--card-edge);
    border-radius: var(--radius);
    background-color: var(--card);
    background-image: var(--impasto-soft);
    background-size: 520px;
    background-blend-mode: soft-light;
    box-shadow: 0 16px 28px -22px rgb(90 50 20 / 0.55);
  }
  .card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }
  .card-title {
    font-family: var(--poster);
    font-weight: 740;
    font-stretch: 85%;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 0.98rem;
    line-height: 1.15;
    text-wrap: balance;
  }
  .tick {
    flex: none;
    overflow: visible;
    margin-top: -2px;
  }
  .tick path {
    fill: none;
    stroke: var(--forest);
    stroke-width: 3.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .stamp {
    flex: none;
    max-width: 11em;
    padding: 3px 7px;
    border: 1.5px solid currentColor;
    border-radius: 3px;
    color: var(--stamp);
    font-weight: 600;
    line-height: 1.25;
    text-align: center;
    transform: rotate(3deg);
  }

  .call {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: clamp(14px, 1.6vw, 22px);
    align-items: end;
    margin-top: clamp(12px, 1.4vw, 20px);
  }
  .verdict {
    font-size: clamp(3.8rem, 1.4rem + 5vw, 7.4rem);
    line-height: 0.82;
    color: var(--forest-deep);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .call-words {
    padding-bottom: 2px;
  }
  .line {
    font-size: 1.04rem;
    font-weight: 560;
    line-height: 1.2;
  }
  .note {
    margin-top: 4px;
    font-size: 0.9rem;
    line-height: 1.3;
    color: var(--ink-2);
  }
  .cold {
    margin-top: 14px;
    padding-left: 10px;
    border-left: 2px solid var(--forest);
    color: var(--ink-2);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .charts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(16px, 2vw, 28px);
    row-gap: 20px;
    margin-top: clamp(18px, 2vw, 26px);
  }
  .chart-title {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding-bottom: 6px;
    margin-bottom: 10px;
    border-bottom: 1.5px solid var(--ink);
    color: var(--ink);
    font-weight: 600;
  }
  .chart-dir {
    color: var(--ink-2);
    font-weight: 460;
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .lanes {
    display: grid;
    row-gap: 9px;
  }
  .lane {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    column-gap: 8px;
    row-gap: 3px;
  }
  .lane-name {
    font-family: var(--poster);
    font-weight: 700;
    font-stretch: 85%;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 0.76rem;
    line-height: 1.15;
    color: var(--ink-2);
  }
  .lane.us .lane-name {
    color: var(--forest-deep);
    font-weight: 900;
  }
  .lane-mode {
    margin-left: 0.5em;
    font-family: var(--sans);
    font-weight: 460;
    font-stretch: 100%;
    text-transform: none;
    letter-spacing: 0;
    color: var(--ink-2);
  }
  .lane-val {
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .lane.pick .lane-val {
    color: var(--ink);
    font-weight: 700;
  }
  .lane.pick.us .lane-val {
    color: var(--forest-deep);
  }
  .lane-track {
    grid-column: 1 / -1;
    display: block;
    height: 9px;
  }
  .lane-bar {
    display: block;
    width: max(4px, calc(100% * var(--w)));
    height: 100%;
    border-radius: 3px 6px 4px 7px / 5px 3px 6px 4px;
    background-color: var(--muted);
    background-image: var(--impasto);
    background-size: 200px;
    background-blend-mode: soft-light;
    transform-origin: left center;
  }
  .lane.pick .lane-bar {
    background-color: var(--ink-2);
  }
  .lane.us .lane-bar {
    background-color: var(--sage-deep);
  }
  .lane.us.pick .lane-bar {
    background-color: var(--forest);
  }
  .meta {
    margin-top: auto;
    padding-top: 16px;
    color: var(--ink-2);
  }

  .fresh {
    grid-column: 1 / -1;
  }
  .fresh-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: clamp(20px, 3vw, 44px);
    row-gap: 18px;
    align-items: start;
    margin-top: clamp(12px, 1.4vw, 18px);
  }
  .fresh .line {
    max-width: 28em;
  }
  .traps {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .trap {
    padding: 3px 8px;
    border: 1px solid var(--rule-strong);
    border-radius: 3px;
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--ink-2);
  }
  .sheet {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .sheet th,
  .sheet td {
    padding: 8px 0 8px 10px;
    text-align: right;
    vertical-align: baseline;
  }
  .sheet th:first-child {
    padding-left: 0;
    text-align: left;
  }
  .sheet thead th {
    padding-bottom: 6px;
    border-bottom: 1.5px solid var(--ink);
    color: var(--ink-2);
    font-weight: 560;
  }
  .sheet tbody tr + tr {
    border-top: 1px solid var(--rule);
  }
  .sheet tbody th {
    font-family: var(--poster);
    font-weight: 900;
    font-stretch: 85%;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 0.82rem;
    line-height: 1.2;
    color: var(--forest-deep);
  }
  .sheet-model {
    display: block;
    font-family: var(--sans);
    font-weight: 460;
    font-stretch: 100%;
    text-transform: none;
    letter-spacing: 0;
    color: var(--ink-2);
  }
  .sheet td {
    font-family: var(--mono);
    font-stretch: 87.5%;
    font-size: 0.82rem;
    color: var(--ink);
    white-space: nowrap;
  }
  .sheet td.pass {
    color: var(--forest-deep);
    font-weight: 700;
  }

  .colophon {
    grid-column: 1 / -1;
    padding: clamp(14px, 1.4vw, 20px) 2px 0;
    border-top: 1.5px solid var(--ink);
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--ink-2);
  }
  .colophon-title {
    color: var(--ink);
    margin-bottom: 8px;
  }
  .fine {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2 22em;
    column-gap: clamp(20px, 3vw, 44px);
  }
  .fine li {
    break-inside: avoid;
    padding-left: 10px;
    margin-bottom: 8px;
    border-left: 2px solid var(--stamp);
  }

  @media (max-width: 1100px) {
    .charts {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 860px) {
    .cu-title,
    .cu-cmd {
      grid-column: 1 / -1;
    }
    .cu-cmd {
      max-width: 30em;
    }
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
    .charts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .fresh-body {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 600px) {
    .cu {
      --radius: 5px 9px 6px 10px / 8px 5px 9px 6px;
    }
    .card {
      padding: 14px 12px;
    }
    .card-title {
      font-size: 0.86rem;
    }
    .stamp {
      font-size: 0.56rem;
      padding: 2px 5px;
      max-width: 9em;
    }
    .verdict {
      font-size: clamp(3.4rem, 2rem + 8vw, 4.6rem);
    }
    .line {
      font-size: 0.94rem;
    }
    .note {
      font-size: 0.84rem;
    }
    .charts {
      grid-template-columns: minmax(0, 1fr);
    }
    .lane-name {
      font-size: 0.72rem;
    }
    .lane-val {
      font-size: 0.66rem;
    }
    .lane-track {
      height: 7px;
    }
    .sheet th,
    .sheet td {
      padding-left: 8px;
    }
    .sheet td {
      font-size: 0.76rem;
    }
    .sheet tbody th {
      font-size: 0.76rem;
    }
    .colophon {
      font-size: 0.8rem;
    }
  }
</style>
