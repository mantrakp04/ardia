---
import { computerUse as cu, type Pairing } from "../data/computerUse";

interface Props {
  page?: boolean;
}
const { page = false } = Astro.props;

const tick = "M3 13.5c2.2 1.4 4.3 3.6 6.4 6.6C13 13 17.6 7.4 25 2.6";
const markGlyph = { pass: "✓", fail: "✗", mixed: "◐" } as const;
const markWord = { pass: "all passed", fail: "failed", mixed: "some passed" } as const;

const speedLine = (p: Pairing) =>
  !p.speed ? "No timed tasks yet" : p.speed.even ? "Dead even with Aside on time" : p.speed.ardiaWins ? "faster than Aside, typical task" : "faster for Aside, typical task";
const tokenLine = (p: Pairing) =>
  !p.tokens ? "–" : p.tokens.even ? "Even" : `${p.tokens.figure} fewer for ${p.tokens.ardiaWins ? "Ardia" : "Aside"}`;
const toggleCss = `@media (max-width: 700px) {${cu.pairings
  .map((p) => `#computer-use .tasks:has(#cu-pair-${p.id}:checked) [data-pair="${p.id}"] { display: table-cell; }`)
  .join(" ")}}`;
const stampOf = (p: Pairing) => (!p.speed || p.speed.even ? "Dead heat" : p.speed.ardiaWins ? null : "Aside’s round");
---

<section
  class:list={["cu paint", { edge: !page, "cu-page": page }]}
  id="computer-use"
  aria-labelledby="cu-title"
  data-shot="computer-use"
>
  <div class="wrap">
    <header class="cu-head">
      <div class="cu-title">
        <p class="label kicker">Bring your own agent</p>
        <h2 class="poster cu-heading" id="cu-title" data-reveal>Computer use.</h2>
        {!cu.complete && <p class="label status">Bench in progress · {cu.runs} of {cu.planned} runs so far</p>}
      </div>
    </header>

    <ul class="cards" role="list">
      {
        cu.pairings.map((p) => {
          const stamp = stampOf(p);
          return (
            <li class:list={["card", "pair", { lost: !!stamp }]} data-reveal>
              <div class="card-top">
                <div>
                  <h3 class="card-title">{p.model}</h3>
                  <p class="label vs">{p.ardia.name} vs Aside, same model</p>
                </div>
                {stamp ? (
                  <p class="label stamp">{stamp}</p>
                ) : (
                  <svg class="tick" viewBox="0 0 28 24" width="24" height="21" role="img" aria-label="Ardia wins on time">
                    <path d={tick} />
                  </svg>
                )}
              </div>
              <div class="call">
                {p.speed && !p.speed.even && <p class="verdict poster">{p.speed.figure}</p>}
                <p class="line">{speedLine(p)}</p>
              </div>
              <dl class="facts">
                <div class="fact">
                  <dt class="label">Checks passed</dt>
                  <dd>
                    <span class="us">Ardia {p.ardia.passes}/{p.ardia.runs}</span> · Aside {p.aside.passes}/{p.aside.runs}
                  </dd>
                </div>
                <div class="fact">
                  <dt class="label">Ardia faster on</dt>
                  <dd>
                    {p.faster} of {p.compared} tasks
                  </dd>
                </div>
                <div class="fact">
                  <dt class="label">Tokens, typical task</dt>
                  <dd>{tokenLine(p)}</dd>
                </div>
              </dl>
            </li>
          );
        })
      }

      <li class="card tasks" data-reveal>
        <div class="tasks-top">
          <h3 class="card-title">Task by task</h3>
          <p class="label legend">Median time · tokens · checks passed of runs. ● wins its pair: more passes, then faster.</p>
        </div>
        <div class="toggle" role="radiogroup" aria-label="Model">
          {
            cu.pairings.map((p, i) => (
              <label class="toggle-opt">
                <input type="radio" name="cu-pair" value={p.id} id={`cu-pair-${p.id}`} checked={i === 0} />
                <span>{p.model}</span>
              </label>
            ))
          }
        </div>
        <div class="scroll">
          <table class="sheet">
            <caption class="visually-hidden">
              Each task’s median time, median tokens and checks passed, per agent. The winner of each same-model pair is marked.
            </caption>
            <thead>
              <tr class="pair-row">
                <td />
                {
                  cu.pairings.map((p) => (
                    <th scope="colgroup" colspan="2" class="label pair-head" data-pair={p.id}>
                      {p.model}
                    </th>
                  ))
                }
              </tr>
              <tr>
                <th scope="col" class="label">Task</th>
                {
                  cu.columns.map((c) => (
                    <th scope="col" class:list={["label", { us: c.isArdia }]} data-pair={c.pair}>
                      {c.name}
                    </th>
                  ))
                }
              </tr>
            </thead>
            <tbody>
              {
                cu.rows.map((r) => (
                  <tr>
                    <th scope="row">
                      <span class="task-name">{r.name}</span>
                      {r.sub && <span class="task-sub">{r.sub}</span>}
                      {r.note && <span class="task-note">{r.note}</span>}
                    </th>
                    {r.entries.map((e) => (
                      <td class:list={{ us: e.isArdia, won: e.won, empty: !e.mark }} data-pair={e.pair}>
                        {e.mark ? (
                          <>
                            <span class="cell-time">
                              {e.won && <span class="dot" aria-hidden="true">●</span>}
                              {e.time ?? "–"}
                              {e.won && <span class="visually-hidden"> (wins its pair)</span>}
                            </span>
                            <span class="cell-meta">
                              {e.tokens ?? "–"} · <span class:list={["mark", e.mark]} aria-hidden="true">{markGlyph[e.mark]}</span>
                              <span class="visually-hidden">{markWord[e.mark]}, </span>
                              {e.result}
                            </span>
                          </>
                        ) : (
                          <span class="cell-meta">not run yet</span>
                        )}
                      </td>
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </li>

      <li class="colophon">
        <p class="label colophon-title">The small print</p>
        <ul class="fine" role="list">
          <li>
            {cu.taskCount} local web apps, {cu.contenderCount} agents, the same prompt for all, graded by a checker on each app’s own
            server. Medians of up to {cu.repeats} runs{!cu.complete && ` (${cu.runs} of ${cu.planned} done)`}, {cu.dates}. Time is
            the median of every run, pass or fail. “Typical task” is the geometric mean of the per-task ratios.
          </li>
          <li>
            Your own Claude Code or Codex drives Ardia through the <code>ardia</code> command. Nothing in Ardia calls a model.
          </li>
          <li>
            Cold every run: Ardia’s site notes wiped, Aside’s memory off, its bench chats deleted before memory came back on. High effort on both sides.
          </li>
          <li>
            Ardia ran hidden. Aside’s window sat on screen behind other windows, and was frontmost at some point in {cu.asideFront} of
            its {cu.asideRuns} runs, mostly while the harness cleaned up the run before.
          </li>
          <li>On docs research the shell agents can read pages with curl; Aside’s agent can’t.</li>
          <li>Aside’s clock starts when the prompt is sent. Ardia’s includes starting the agent’s CLI.</li>
          <li>Claude Code reached the model through a local proxy. Aside used its own subscription providers.</li>
          <li>
            Aside {cu.asideVersion}, its in-browser agent only, not its desktop Computer Use. Ardia nightly: the <code>ardia</code> command
            features shipped in 0.2.45-nightly.2.
          </li>
        </ul>
        <a class="link label" href={cu.source} rel="noopener" data-track="github_clicked" data-track-link="agent_bench" data-track-location="computer_use"
          >Rerun the bench</a
        >
      </li>
    </ul>
  </div>
</section>

<style is:inline set:html={toggleCss}></style>

<style>
  :global(#demo) + .cu {
    margin-top: calc(var(--edge) + clamp(32px, 4vw, 64px));
  }
  .cu {
    --bg: var(--noon);
    --bg-top: #f3e9d6;
    --wash: linear-gradient(180deg, #f3e9d6 0%, var(--noon) 45%, #f0c983 100%);
    --dab: var(--forest);
    --ink-2: #3a372f;
    --muted: #8c6a4c;
    --card: #fbf5e8;
    --card-edge: rgb(22 19 15 / 0.82);
    --radius: 7px 12px 8px 14px / 11px 7px 13px 8px;
    padding: var(--section) 0 clamp(72px, 9vw, 140px);
  }
  .cu + :global(.bb.edge) {
    padding-top: clamp(56px, 6vw, 112px);
  }
  .cu-page {
    padding-top: clamp(40px, 5vw, 88px);
  }
  .cu-head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    align-items: end;
    margin-bottom: clamp(24px, 3vw, 44px);
  }
  .cu-title {
    grid-column: 1 / span 7;
  }
  .cu-heading {
    font-size: var(--t-h2);
  }
  .status {
    display: inline-block;
    margin-top: 20px;
    padding: 4px 10px;
    color: var(--stamp);
    border: 1.5px solid currentColor;
    border-radius: 3px;
    transform: rotate(-1.5deg);
  }
  code {
    font-family: var(--mono);
    font-size: 0.86em;
    font-stretch: 87.5%;
  }

  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(10px, 1.3vw, 18px);
  }
  .card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(14px, 1.6vw, 22px);
    border: 1.5px solid var(--card-edge);
    border-radius: var(--radius);
    background-color: var(--card);
    background-image: var(--impasto-soft);
    background-size: 520px;
    background-blend-mode: soft-light;
    box-shadow: 0 16px 28px -22px rgb(90 50 20 / 0.55);
  }
  .card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }
  .card-title {
    font-family: var(--poster);
    font-weight: 740;
    font-stretch: 85%;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 0.98rem;
    line-height: 1.15;
    text-wrap: balance;
  }
  .vs {
    margin-top: 2px;
    color: var(--ink-2);
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .tick {
    flex: none;
    overflow: visible;
    margin-top: -2px;
  }
  .tick path {
    fill: none;
    stroke: var(--forest);
    stroke-width: 3.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .stamp {
    flex: none;
    max-width: 10em;
    padding: 3px 7px;
    border: 1.5px solid currentColor;
    border-radius: 3px;
    color: var(--stamp);
    font-weight: 600;
    line-height: 1.25;
    text-align: center;
    transform: rotate(3deg);
  }

  .call {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    column-gap: clamp(14px, 1.6vw, 22px);
    row-gap: 8px;
    margin-top: clamp(14px, 1.6vw, 22px);
  }
  .verdict {
    font-size: clamp(3.8rem, 1.4rem + 5vw, 7.4rem);
    line-height: 0.82;
    color: var(--forest-deep);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .pair.lost .verdict {
    color: var(--ink);
  }
  .line {
    flex: 1 1 10em;
    padding-bottom: 2px;
    font-size: 1.04rem;
    font-weight: 560;
    line-height: 1.2;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin: clamp(16px, 1.8vw, 24px) 0 0;
    padding-top: 12px;
    border-top: 1.5px solid var(--ink);
  }
  .fact dt {
    color: var(--ink-2);
  }
  .fact dd {
    margin: 4px 0 0;
    font-size: 0.94rem;
    font-weight: 560;
    line-height: 1.3;
  }
  .fact .us {
    color: var(--forest-deep);
  }

  .tasks {
    grid-column: 1 / -1;
  }
  .tasks-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 20px;
  }
  .legend {
    color: var(--ink-2);
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .toggle {
    display: none;
  }
  .scroll {
    margin-top: 14px;
    overflow-x: auto;
  }
  .sheet {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .sheet th,
  .sheet td {
    padding: 9px 0 9px 12px;
    text-align: right;
    vertical-align: top;
  }
  .sheet tr > :first-child {
    padding-left: 0;
    text-align: left;
  }
  .pair-row th {
    padding-bottom: 2px;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    font-weight: 600;
    text-align: center;
  }
  .sheet thead tr:last-child th {
    padding-top: 6px;
    padding-bottom: 6px;
    border-bottom: 1.5px solid var(--ink);
    color: var(--ink-2);
    font-weight: 560;
    text-transform: none;
    letter-spacing: 0.02em;
    vertical-align: bottom;
  }
  .sheet thead th.us {
    color: var(--forest-deep);
    font-weight: 700;
  }
  .sheet tbody tr + tr {
    border-top: 1px solid var(--rule);
  }
  .sheet tbody th {
    max-width: 18em;
  }
  .task-name {
    display: block;
    font-family: var(--poster);
    font-weight: 740;
    font-stretch: 85%;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 0.84rem;
    line-height: 1.2;
  }
  .task-sub {
    display: block;
    margin-top: 2px;
    font-size: 0.82rem;
    font-weight: 440;
    line-height: 1.3;
    color: var(--ink-2);
  }
  .task-note {
    display: block;
    margin-top: 4px;
    padding-left: 8px;
    border-left: 2px solid var(--stamp);
    font-size: 0.76rem;
    font-weight: 440;
    line-height: 1.3;
    color: var(--ink-2);
  }
  .sheet td {
    font-family: var(--mono);
    font-stretch: 87.5%;
    white-space: nowrap;
  }
  .cell-time {
    display: block;
    font-size: 0.86rem;
    color: var(--ink-2);
  }
  .won .cell-time {
    color: var(--ink);
    font-weight: 700;
  }
  .won.us .cell-time {
    color: var(--forest-deep);
  }
  .dot {
    margin-right: 0.35em;
    font-size: 0.7em;
    vertical-align: 0.12em;
  }
  .cell-meta {
    display: block;
    margin-top: 2px;
    font-size: 0.72rem;
    color: var(--ink-2);
  }
  .empty .cell-meta {
    color: var(--muted);
  }
  .mark.pass {
    color: var(--forest);
    font-weight: 700;
  }
  .mark.fail,
  .mark.mixed {
    color: var(--stamp);
    font-weight: 700;
  }

  .colophon {
    grid-column: 1 / -1;
    padding: clamp(14px, 1.4vw, 20px) 2px 0;
    border-top: 1.5px solid var(--ink);
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--ink-2);
  }
  .colophon-title {
    color: var(--ink);
    margin-bottom: 8px;
  }
  .fine {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2 22em;
    column-gap: clamp(20px, 3vw, 44px);
  }
  .fine li {
    break-inside: avoid;
    padding-left: 10px;
    margin-bottom: 8px;
    border-left: 2px solid var(--stamp);
  }
  .colophon .link {
    display: inline-block;
    margin-top: 6px;
    color: var(--ink);
    font-weight: 600;
  }
  .colophon .link::after {
    content: " →";
  }

  @media (max-width: 1100px) {
    .facts {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }
    .fact {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 12px;
    }
    .fact dd {
      margin: 0;
      text-align: right;
    }
  }
  @media (max-width: 860px) {
    .cu-title {
      grid-column: 1 / -1;
    }
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 700px) {
    .toggle {
      display: inline-flex;
      margin-top: 14px;
      padding: 3px;
      border: 1.5px solid var(--ink);
      border-radius: 6px;
    }
    .toggle-opt {
      position: relative;
      cursor: pointer;
    }
    .toggle-opt input {
      position: absolute;
      opacity: 0;
      inset: 0;
      margin: 0;
      cursor: pointer;
    }
    .toggle-opt span {
      display: block;
      padding: 7px 14px;
      border-radius: 4px;
      font-family: var(--poster);
      font-weight: 740;
      font-stretch: 85%;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      font-size: 0.82rem;
      color: var(--ink-2);
    }
    .toggle-opt input:checked + span {
      background: var(--ink);
      color: var(--paper);
    }
    .toggle-opt input:focus-visible + span {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }
    .pair-row {
      display: none;
    }
    .tasks:has(input[value]:checked) [data-pair] {
      display: none;
    }
    .sheet th,
    .sheet td {
      padding-left: 16px;
    }
    .sheet tbody th {
      max-width: none;
    }
    .task-sub {
      font-size: 0.76rem;
    }
  }
  @media (max-width: 600px) {
    .cu {
      --radius: 5px 9px 6px 10px / 8px 5px 9px 6px;
    }
    .card {
      padding: 14px 12px;
    }
    .card-title {
      font-size: 0.86rem;
    }
    .stamp {
      font-size: 0.56rem;
      padding: 2px 5px;
    }
    .verdict {
      font-size: clamp(3.4rem, 2rem + 8vw, 4.6rem);
    }
    .line {
      font-size: 0.94rem;
    }
    .fact dd {
      font-size: 0.86rem;
    }
    .colophon {
      font-size: 0.8rem;
    }
  }
</style>
