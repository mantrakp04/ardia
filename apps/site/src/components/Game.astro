---
import { Image, Picture } from "astro:assets";
import crowd from "../assets/game/crowd.webp";
import lost from "../assets/game/lost.webp";

const spot = { x: 0.118, y: 0.31, r: 0.045 };
---

<section class="game paint" id="game" aria-labelledby="game-title" data-shot="game">
  <div class="wrap">
    <div class="game-head">
      <div class="lost">
        <Image src={lost} alt="A painted notice nailed to a fence post: LOST, over a portrait of a black-faced lamb with a yellow bell." width={120} height={120} densities={[1, 2]} />
        <p class="label">Answers to<br />a yellow bell</p>
      </div>
      <div class="game-title">
        <p class="label kicker">The offline page</p>
        <h2 class="poster" id="game-title" data-reveal>Where’s the lamb?</h2>
      </div>
      <p class="game-copy" data-reveal style="--i: 1">
        Wi-Fi died? Chrome gives you a dinosaur. Ardia gives you a hillside of sheep, goats and very helpful dogs,
        and one lamb with a yellow bell. Find her.<span class="swipe"> Swipe the flock, she’s in there.</span>{" "}Online
        too, at <code>ardia://game</code>.
      </p>
    </div>

    <figure class="board" data-board>
      <div class="view">
      <div class="pan" data-pan>
      <div class="board-img" style={`aspect-ratio: ${crowd.width} / ${crowd.height}`}>
        <Picture
          src={crowd}
          alt="A screenshot of the game: a painted meadow packed with sheep, goats and sheepdogs, the lost lamb somewhere among them."
          formats={["avif"]}
          fallbackFormat="webp"
          widths={[640, 1024, 1440, 2252]}
          sizes="(max-width: 700px) 240vw, (max-width: 1440px) 94vw, 1360px"
          loading="lazy"
        />
        <button
          class="found"
          type="button"
          data-found
          aria-label="That’s her. Reveal the lamb."
          style={`left: ${(spot.x - spot.r) * 100}%; top: ${spot.y * 100}%; width: ${spot.r * 200}%`}
        ></button>
      </div>
      </div>
        <p class="toast label" role="status" aria-live="polite" data-toast></p>
      </div>
    </figure>
  </div>
</section>

<style>
  .game {
    --bg: var(--golden-late);
    --wash: linear-gradient(180deg, var(--golden-late) 0%, #e8a682 100%);
    --dab: var(--forest);
    padding: clamp(24px, 4vw, 64px) 0 var(--section);
  }
  .game-head {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: "lost title" "lost copy";
    column-gap: clamp(20px, 3vw, 40px);
    row-gap: 24px;
    align-items: end;
    margin-bottom: clamp(32px, 5vw, 56px);
  }
  .lost {
    grid-area: lost;
    align-self: start;
    text-align: center;
    border: 2px solid var(--ink);
    padding: 10px 10px 8px;
    background: #fbf6e4;
    box-shadow: 0 10px 20px -12px rgb(60 30 20 / 0.5);
    transform: rotate(-3deg);
    width: clamp(96px, 12vw, 148px);
  }
  .lost :global(img) {
    width: 100%;
    height: auto;
  }
  .lost p {
    margin-top: 6px;
    font-size: 0.6rem;
    line-height: 1.3;
  }
  .game-title {
    grid-area: title;
  }
  h2 {
    font-size: var(--t-h2);
  }
  .game-copy {
    grid-area: copy;
    max-width: 36em;
    color: var(--ink-2);
  }
  .game-copy code {
    font-family: var(--mono);
    font-size: 0.8em;
    font-stretch: 87.5%;
    color: var(--ink);
  }
  .board {
    position: relative;
    margin: 0;
    cursor: crosshair;
  }
  .view {
    padding: clamp(8px, 1.2vw, 16px);
    border-radius: 10px 16px 8px 18px / 14px 8px 18px 10px;
    background-color: var(--forest-deep);
    background-image: var(--impasto);
    background-size: 300px;
    background-blend-mode: soft-light;
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.12),
      0 30px 60px -28px rgb(60 30 20 / 0.55);
  }
  .board :global(img) {
    width: 100%;
    height: auto;
    border-radius: 4px;
  }
  .view {
    position: relative;
  }
  .board-img {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
  }
  .swipe {
    display: none;
  }
  .found {
    position: absolute;
    aspect-ratio: 1;
    transform: translateY(-50%);
    border: 0;
    border-radius: 50%;
    background: transparent;
    cursor: crosshair;
    padding: 0;
  }
  .found:focus-visible,
  .board[data-solved] .found {
    outline: 3px solid var(--sun);
    outline-offset: 2px;
    box-shadow: 0 0 0 9999px rgb(22 19 15 / 0.55);
  }
  .toast {
    position: absolute;
    left: 16px;
    bottom: 16px;
    margin: 0;
    background: var(--ink);
    color: var(--paper);
    padding: 10px 14px;
    border-radius: 3px;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 200ms var(--ease-out),
      transform 200ms var(--ease-out);
    pointer-events: none;
  }
  .toast[data-show] {
    opacity: 1;
    transform: none;
  }
  @media (max-width: 700px) {
    .game-head {
      grid-template-columns: 1fr auto;
      grid-template-areas: "title lost" "copy copy";
    }
    .pan {
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      border-radius: 6px;
      -webkit-overflow-scrolling: touch;
    }
    .pan::-webkit-scrollbar {
      display: none;
    }
    .board-img {
      width: 240%;
      border-radius: 0;
    }
    .board :global(img) {
      border-radius: 0;
    }
    .swipe {
      display: inline;
    }
  }
</style>

<script>
  import { capture } from "../scripts/telemetry";

  const board = document.querySelector<HTMLElement>("[data-board]");
  const spot = board?.querySelector<HTMLButtonElement>("[data-found]");
  const toast = board?.querySelector<HTMLElement>("[data-toast]");
  const pan = board?.querySelector<HTMLElement>("[data-pan]");
  if (pan && pan.scrollWidth > pan.clientWidth) pan.scrollLeft = pan.scrollWidth;
  if (board && spot && toast) {
    let started = 0;
    let misses = 0;
    new IntersectionObserver(([e], io) => {
      if (!e.isIntersecting) return;
      started = performance.now();
      io.disconnect();
    }, { threshold: 0.5 }).observe(board);

    const say = (text: string) => {
      toast.textContent = text;
      toast.setAttribute("data-show", "");
      clearTimeout(Number(toast.dataset.t));
      toast.dataset.t = String(setTimeout(() => toast.removeAttribute("data-show"), 2600));
    };
    let found = "";
    spot.addEventListener("click", (e) => {
      e.stopPropagation();
      if (found) return say(found);
      board.setAttribute("data-solved", "");
      const s = started ? ((performance.now() - started) / 1000).toFixed(1) : null;
      found = s ? `Found her in ${s} s. She hides better offline.` : "Found her. She hides better offline.";
      say(found);
      capture("game_solved", { seconds: s ? Number(s) : null, misses });
    });
    const lines = ["Not her. That’s just the flock.", "Wrong woolly.", "Close. Look for the yellow bell.", "Not her. Keep looking."];
    board.addEventListener("click", () => say(found || lines[misses++ % lines.length]));
  }
</script>
