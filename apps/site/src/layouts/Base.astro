---
import { createHash } from "node:crypto";
import { readFileSync } from "node:fs";
import "../styles/fonts.css";
import monaLatin from "../assets/fonts/mona-sans-core.woff2?url";
import martianLatin from "../assets/fonts/martian-mono-core.woff2?url";
import "../styles/global.css";
import Device from "../components/Device.astro";

interface Props {
  title: string;
  description: string;
  jsonLd?: object[];
  noindex?: boolean;
  article?: { published: string };
}
const { title, description, jsonLd = [], noindex = false, article } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogVersion = createHash("sha256").update(readFileSync(`${process.cwd()}/public/og.png`)).digest("hex").slice(0, 10);
const og = new URL(`${base}/og.png?v=${ogVersion}`, Astro.site);
const OG_ALT =
  "Touch grass. The Ardia logo, two painted green hills under a yellow sun, standing in a painted morning meadow. Arc’s sidebar and Dia’s polish, on real Chromium, for the Mac.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f1ece2" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="48x48" />
    <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content={article ? "article" : "website"} />
    {article && <meta property="article:published_time" content={article.published} />}
    <meta property="og:site_name" content="Ardia" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={OG_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image:alt" content={OG_ALT} />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <link rel="preload" href={monaLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={martianLatin} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <Device />
  </head>
  <body>
    <slot />
    <script>
      import "../scripts/analytics";
      import "../scripts/send-to-mac";
      import "../scripts/lightbox";
    </script>
  </body>
</html>
