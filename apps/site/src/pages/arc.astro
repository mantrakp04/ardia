---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import DownloadButton from "../components/DownloadButton.astro";
import Closing from "../components/Closing.astro";
import Footer from "../components/Footer.astro";
import { MIN_MACOS, VERSION } from "../data/release";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const home = new URL(`${base}/`, Astro.site).href;
const url = new URL("arc/", home).href;
const title = "Moving from Arc? A free Arc replacement for Mac · Ardia";
const description =
  "Arc stops working on December 22, 2026. Ardia is a free, open-source Mac browser with Arc’s sidebar that imports your spaces, pinned tabs, folders and themes.";
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description,
    url,
    isPartOf: { "@type": "WebSite", name: "Ardia", url: home },
    about: {
      "@type": "SoftwareApplication",
      name: "Ardia",
      applicationCategory: "BrowserApplication",
      operatingSystem: `${MIN_MACOS} or later, Apple Silicon`,
      softwareVersion: VERSION,
      url: home,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Ardia", item: home },
      { "@type": "ListItem", position: 2, name: "Moving from Arc", item: url },
    ],
  },
];

const carried = [
  { from: "Spaces", to: "The first space you pick fills the profile you import into. Each other one becomes its own profile, with its name and colour. Every space keeps its theme." },
  { from: "Pinned tabs", to: "Pinned rows in that profile, with the names you gave them." },
  { from: "Pinned folders", to: "Pinned groups. Folders inside folders stay nested." },
  { from: "Favorites", to: "Tiles at the top of the sidebar." },
  { from: "Open tabs", to: "An “Imported” group. Tabs already open in Ardia, and internal pages like arc://, are skipped." },
  { from: "Bookmarks, history, passwords, cookies", to: "Into the first profile, so you’re still signed in there." },
  { from: "Extensions", to: "Listed after the import, so you can add them back from the Chrome Web Store." },
];

const timeline = [
  { date: "October 22", what: "No new Arc accounts." },
  { date: "November 23", what: "Arc Search on phones loses sign-in and sync." },
  { date: "December 22", what: "Arc stops opening on Mac and Windows. Accounts are deactivated, their data deleted within 30 days." },
];
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <Header home={`${base}/`} />
  <main>
    <section class="intro" aria-labelledby="arc-title">
      <div class="wrap">
        <p class="label kicker">Moving from Arc</p>
        <h1 class="poster" id="arc-title"><span class="visually-hidden">Moving from Arc to Ardia: </span>Keep the sidebar.</h1>
        <p class="lede">
          Arc stops opening on December 22, 2026. Ardia is a free, open-source Arc alternative for Mac: Arc’s sidebar on real
          Chromium, and it imports your spaces, pinned tabs, folders and themes in one go.
        </p>
        <div class="cta">
          <DownloadButton location="arc" />
          <a class="link" href={`${base}/try/`}>Try the sidebar first</a>
        </div>
        <p class="label fine not-phone">{MIN_MACOS} or later · Apple Silicon · Notarized by Apple</p>
      </div>
    </section>

    <section class="block" aria-labelledby="carried-title">
      <div class="wrap">
        <h2 class="poster" id="carried-title">What comes over</h2>
        <dl class="rows">
          {
            carried.map((row) => (
              <div class="row">
                <dt>{row.from}</dt>
                <dd>{row.to}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="block" aria-labelledby="same-title">
      <div class="wrap">
        <h2 class="poster" id="same-title">What feels the same</h2>
        <div class="cols">
          <div class="col">
            <h3>The sidebar</h3>
            <p>Pinned tabs, groups and today’s tabs down the side, in Arc’s layout. Hide it when you want the whole screen.</p>
          </div>
          <div class="col">
            <h3>Split view, Peek, Little Arc</h3>
            <p>Up to three pages side by side. ⇧-click a link to peek at it. ⌥⌘N opens a Little Ardia window.</p>
          </div>
          <div class="col">
            <h3>The command bar</h3>
            <p>⌘T and ⌘L open one box for tabs, history, settings and search.</p>
          </div>
          <div class="col">
            <h3>Themes</h3>
            <p>Arc’s gradient themes, grain included. Settings › Profiles › Theme › Import from Arc… brings one over on its own.</p>
          </div>
          <div class="col">
            <h3>Real Chromium</h3>
            <p>Sites and Chrome extensions just work. uBlock Origin is built in.</p>
          </div>
          <div class="col">
            <h3>Ships most weeks</h3>
            <p>Open source under GPL-3.0. The <a class="link" href={`${base}/release-notes/`}>release notes</a> say what changed.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="block" aria-labelledby="missing-title">
      <div class="wrap">
        <h2 class="poster" id="missing-title">What doesn’t</h2>
        <ul class="plain">
          <li><strong>Boosts and Easels.</strong> There’s no Boosts editor and no Easels.</li>
          <li><strong>Arc Max.</strong> Ardia has no AI, on purpose.</li>
          <li><strong>Windows and Intel Macs.</strong> Ardia needs Apple Silicon and {MIN_MACOS} or later.</li>
        </ul>
      </div>
    </section>

    <section class="block" aria-labelledby="switch-title">
      <div class="wrap">
        <h2 class="poster" id="switch-title">How to switch</h2>
        <ol class="steps">
          <li>Download Ardia and drag it into Applications.</li>
          <li>Keep Arc installed. In Ardia, open Ardia › Import from Another Browser… and pick Arc.</li>
          <li>Pick the spaces to bring. macOS asks once to unlock Arc’s saved passwords, so they and your cookies come too.</li>
          <li>Make Ardia your default browser in Settings › General.</li>
        </ol>
      </div>
    </section>

    <section class="block" aria-labelledby="when-title">
      <div class="wrap">
        <h2 class="poster" id="when-title">Arc’s last weeks</h2>
        <dl class="rows">
          {
            timeline.map((row) => (
              <div class="row">
                <dt>{row.date}</dt>
                <dd>{row.what}</dd>
              </div>
            ))
          }
        </dl>
        <p class="note">Import while Arc still works. After December 22 there’s no Arc left to ask.</p>
      </div>
    </section>

    <section class="block last" aria-labelledby="dia-title">
      <div class="wrap">
        <h2 class="poster" id="dia-title">Why not Dia?</h2>
        <p class="note">
          Arc points you to Dia, made by the same team. Dia is built around AI and runs on Windows too. Ardia dresses like Dia, keeps
          Arc’s sidebar, and leaves the AI out. Both import from Arc, so try both.
        </p>
      </div>
    </section>

    <Closing />
  </main>
  <Footer />
</Base>

<style>
  .intro {
    padding: clamp(36px, 5vw, 80px) 0 clamp(8px, 1.5vw, 24px);
  }
  .intro h1 {
    font-size: var(--t-mega);
    line-height: 0.82;
    margin-left: -0.04em;
  }
  .lede {
    margin-top: clamp(20px, 2.4vw, 32px);
    max-width: 32em;
    font-size: var(--t-lede);
    color: var(--ink-2);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: 32px;
  }
  .cta .link {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .fine {
    margin-top: 18px;
    color: var(--ink-3);
  }
  .block {
    margin-top: clamp(56px, 7vw, 112px);
  }
  .block h2 {
    font-size: var(--t-h3);
  }
  .rows {
    margin: clamp(20px, 2.4vw, 32px) 0 0;
    border-top: 2px solid var(--ink);
    max-width: 60rem;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: 8px var(--gutter);
    padding: 16px 0;
    border-bottom: 1px solid var(--rule);
  }
  .row dt {
    font-weight: 620;
  }
  .row dd {
    margin: 0;
    color: var(--ink-2);
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 48px);
    margin-top: clamp(20px, 2.4vw, 32px);
    border-top: 2px solid var(--ink);
    padding-top: 24px;
  }
  .col h3 {
    font-weight: 620;
    font-stretch: 104%;
    font-size: 1.25rem;
    line-height: 1.25;
    letter-spacing: -0.018em;
  }
  .col p {
    margin-top: 10px;
    color: var(--ink-2);
  }
  .plain,
  .steps {
    margin: clamp(20px, 2.4vw, 32px) 0 0;
    max-width: 40rem;
    border-top: 2px solid var(--ink);
    padding-top: 16px;
  }
  .plain {
    list-style: none;
    padding-left: 0;
  }
  .steps {
    padding-left: 1.4em;
  }
  .plain li,
  .steps li {
    padding: 8px 0;
    color: var(--ink-2);
  }
  .plain strong {
    color: var(--ink);
    font-weight: 620;
  }
  .note {
    margin-top: 20px;
    max-width: 40rem;
    color: var(--ink-2);
  }
  .block.last {
    margin-bottom: var(--section);
  }
  @media (max-width: 820px) {
    .cols {
      grid-template-columns: 1fr;
    }
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import "../scripts/motion";
</script>
