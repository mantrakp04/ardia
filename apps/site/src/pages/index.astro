---
import { homeUrl } from "../data/site";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Showcase from "../components/Showcase.astro";
import Bench from "../components/Bench.astro";
import Game from "../components/Game.astro";
import Faq from "../components/Faq.astro";
import Closing from "../components/Closing.astro";
import Footer from "../components/Footer.astro";
import { DMG, DMG_SIZE, MIN_MACOS, REPO, VERSION } from "../data/release";
import { HERO_POSTERS } from "../data/heroPoster";
import { faqJsonLd } from "../data/faq";

const home = homeUrl(Astro.site);
const description =
  "A Mac browser with Arc's sidebar and Dia's polish, built on real Chromium. Free, open source and notarized by Apple, with ads and trackers kept out.";
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Ardia",
    description,
    url: home,
    image: new URL("og.png", home).href,
    applicationCategory: "BrowserApplication",
    operatingSystem: `${MIN_MACOS} or later, Apple Silicon`,
    softwareVersion: VERSION,
    downloadUrl: DMG,
    fileSize: DMG_SIZE,
    releaseNotes: new URL("release-notes/", home).href,
    license: "https://www.gnu.org/licenses/gpl-3.0.html",
    sameAs: [REPO],
  },
  { "@context": "https://schema.org", "@type": "WebSite", name: "Ardia", url: home },
  faqJsonLd(),
];
---

<Base
  title="Ardia · a free Arc alternative for Mac, with Dia’s polish"
  description={description}
  jsonLd={jsonLd}
>
  {
    HERO_POSTERS.map((poster) => (
      <link
        slot="head"
        rel="preload"
        as="image"
        type="image/webp"
        media={poster.media}
        imagesrcset={poster.srcset}
        imagesizes={poster.sizes}
        fetchpriority="high"
      />
    ))
  }
  <Header />
  <main>
    <Hero />
    <Showcase />
    <Bench />
    <Game />
    <Faq />
    <Closing />
  </main>
  <Footer />
</Base>

<script>
  import "../scripts/motion";
  import "../scripts/tilt";
</script>
