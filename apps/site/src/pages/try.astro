---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Showcase from "../components/Showcase.astro";
import Closing from "../components/Closing.astro";
import Footer from "../components/Footer.astro";
import { MIN_MACOS, VERSION } from "../data/release";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const home = new URL(import.meta.env.BASE_URL, Astro.site).href;
const url = new URL("try/", home).href;
const title = "Try Ardia live · an Arc and Dia alternative you can click";
const description =
  "Click around the real Ardia sidebar right here: tabs, split view, the command bar, profiles. Free for Mac once you’re done kicking the tyres.";
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description,
    url,
    isPartOf: { "@type": "WebSite", name: "Ardia", url: home },
    about: {
      "@type": "SoftwareApplication",
      name: "Ardia",
      applicationCategory: "BrowserApplication",
      operatingSystem: `${MIN_MACOS} or later, Apple Silicon`,
      softwareVersion: VERSION,
      url: home,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Ardia", item: home },
      { "@type": "ListItem", position: 2, name: "Demo", item: url },
    ],
  },
];
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <Header home={`${base}/`} current="try" />
  <main>
    <section class="intro" aria-labelledby="try-title">
      <div class="wrap">
        <p class="label kicker">Live demo</p>
        <h1 class="poster" id="try-title"><span class="visually-hidden">Try Ardia in your browser: </span>Kick the tyres.</h1>
        <p class="lede">
          The real sidebar, running in this page. Click a tab, split two side by side, put the tabs on top, open the command bar.
          Nothing to install until you want the real thing.
        </p>
      </div>
    </section>

    <Showcase />

    <section class="what paint edge" aria-labelledby="what-title">
      <div class="wrap">
        <p class="label kicker">What you just clicked</p>
        <h2 class="poster" id="what-title">Arc’s sidebar. Dia’s polish.</h2>
        <div class="cols">
          <div class="col">
            <h3>Coming from Arc?</h3>
            <p>
              Same sidebar, same muscle memory. The importer brings your spaces, pinned tabs and their names along. It ships most weeks,
              and the <a class="link" href={`${base}/release-notes/`}>release notes</a> say what changed.
            </p>
          </div>
          <div class="col">
            <h3>Miss Dia’s looks?</h3>
            <p>
              It dresses like Dia, or like Arc if you ask. Underneath it’s real Chromium, so sites and Chrome extensions just work. No AI
              tucked in anywhere.
            </p>
          </div>
          <div class="col">
            <h3>Is it quick?</h3>
            <p>
              Measured against Dia and Helium on one Mac, with the rows it loses left in. <a class="link" href={`${base}/benchmarks/`}
                >See the benchmarks</a
              >.
            </p>
          </div>
        </div>
      </div>
    </section>

    <Closing />
  </main>
  <Footer />
</Base>

<style>
  .intro {
    padding: clamp(36px, 5vw, 80px) 0 clamp(8px, 1.5vw, 24px);
  }
  .intro h1 {
    font-size: var(--t-mega);
    line-height: 0.82;
    margin-left: -0.04em;
  }
  .lede {
    margin-top: clamp(20px, 2.4vw, 32px);
    max-width: 30em;
    font-size: var(--t-lede);
    color: var(--ink-2);
  }
  .what {
    --bg: var(--noon);
    --wash: linear-gradient(180deg, #e9ead8 0%, var(--noon) 40%, var(--golden) 100%);
    margin-top: var(--section);
    padding: clamp(64px, 8vw, 120px) 0 var(--section);
  }
  .what h2 {
    font-size: var(--t-h2);
    max-width: 12em;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 48px);
    margin-top: clamp(36px, 4vw, 64px);
    border-top: 2px solid var(--ink);
    padding-top: 24px;
  }
  .col h3 {
    font-weight: 620;
    font-stretch: 104%;
    font-size: 1.25rem;
    line-height: 1.25;
    letter-spacing: -0.018em;
  }
  .col p {
    margin-top: 10px;
    color: var(--ink-2);
  }
  @media (max-width: 820px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import "../scripts/motion";
  import "../scripts/tilt";
</script>
