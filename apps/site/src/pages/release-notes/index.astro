---
import { Picture } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import DownloadButton from "../../components/DownloadButton.astro";
import SendToMac from "../../components/SendToMac.astro";
import NotesBody from "../../components/NotesBody.astro";
import { NIGHTLY } from "../../data/release";
import { isoDate, releasePath, releases as loadReleases } from "../../data/releaseNotes";
import hills from "../../assets/paint/hills.png";
import sun from "../../assets/paint/sun.png";

const OPEN_COUNT = 6;
const VIEW_KEY = "ac:release-notes-view";
const placeInChannel = new Map<string, number>();
const releases = (await loadReleases()).map((r) => {
  const channel = r.nightly ? "nightly" : "stable";
  const place = placeInChannel.get(channel) ?? 0;
  placeInChannel.set(channel, place + 1);
  return { ...r, open: place < OPEN_COUNT };
});
const stable = releases.filter((r) => !r.nightly);
const nightlyCount = releases.length - stable.length;
const latest = stable[0]!;
const longDate = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const dayMonth = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", timeZone: "UTC" });
const monthYear = new Intl.DateTimeFormat("en-GB", { month: "long", year: "numeric", timeZone: "UTC" });
const months = releases.reduce<{ label: string; releases: typeof releases }[]>((acc, r) => {
  const label = monthYear.format(r.date);
  const group = acc.at(-1);
  if (group?.label === label) group.releases.push(r);
  else acc.push({ label, releases: [r] });
  return acc;
}, []);
const onlyNightlies = (group: typeof releases) => group.every((r) => r.nightly);
const dabs = ["var(--sun)", "var(--sage)", "#e98f3c", "#d98a6c"];
const nightlyDab = "#a99bd0";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const home = new URL(import.meta.env.BASE_URL, Astro.site).href;
const page = new URL("release-notes/", home).href;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Ardia release notes",
    url: page,
    isPartOf: { "@type": "WebSite", name: "Ardia", url: home },
    about: { "@type": "SoftwareApplication", name: "Ardia", applicationCategory: "BrowserApplication", operatingSystem: "macOS" },
    dateModified: isoDate(releases[0]!.date),
    mainEntity: {
      "@type": "ItemList",
      itemListOrder: "https://schema.org/ItemListOrderDescending",
      numberOfItems: stable.length,
      itemListElement: stable.map((r, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: new URL(releasePath(r.version), home).href,
        name: `Ardia ${r.version}: ${r.headline}`,
      })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Ardia", item: home },
      { "@type": "ListItem", position: 2, name: "Release notes", item: page },
    ],
  },
];
---

<Base
  title="Ardia release notes · every update, newest first"
  description={`What’s new, fixed and faster in every Ardia release, from 0.1.0 to ${latest.version}. The Mac browser with Arc’s sidebar ships often, and writes it all down.`}
  jsonLd={jsonLd}
>
  <script is:inline slot="head" define:vars={{ viewKey: VIEW_KEY }}>
    const root = document.documentElement;
    let target = "";
    let saved = null;
    try {
      target = decodeURIComponent(location.hash.slice(1));
    } catch {}
    try {
      saved = localStorage.getItem(viewKey);
    } catch {}
    const view = saved === "all" || /-nightly\.\d+$/.test(target) ? "all" : "stable";
    root.dataset.notesView = view;
    let radioSet = view === "stable";
    let foldSet = !target;
    if (!radioSet || !foldSet) {
      const settle = () => {
        if (!radioSet) {
          const all = document.getElementById("view-all");
          if (all) {
            all.checked = true;
            radioSet = true;
          }
        }
        if (!foldSet) {
          const fold = document.getElementById(target)?.querySelector("details[data-fold]");
          if (fold) {
            fold.open = true;
            foldSet = true;
          }
        }
        if (radioSet && foldSet) watch.disconnect();
      };
      const watch = new MutationObserver(settle);
      watch.observe(root, { childList: true, subtree: true });
      addEventListener("DOMContentLoaded", () => watch.disconnect(), { once: true });
    }
  </script>
  <Header home={`${base}/`} current="notes" />
  <main class="almanac">
    <section class="masthead" aria-labelledby="notes-title">
      <div class="wrap mast-grid">
        <div class="mast-copy">
          <p class="label kicker">Release notes</p>
          <h1 class="poster title" id="notes-title">
            <span class="visually-hidden">Ardia release notes: </span>Fresh<br />paint.
          </h1>
          <p class="lede">
            Every update, newest on top. {stable.length} so far, and the app brings you here after each one.
          </p>
        </div>
        <a class="newest" href={`#${latest.version}`}>
          <span class="label newest-tag">Latest · {dayMonth.format(latest.date)}</span>
          <span class="poster newest-version">{latest.version}</span>
          <span class="newest-headline">{latest.headline}</span>
        </a>
        <div class="mast-art" aria-hidden="true">
          <Picture class="mast-sun" src={sun} alt="" formats={["avif"]} fallbackFormat="webp" widths={[120, 200]} sizes="100px" loading="eager" />
          <Picture
            class="mast-hills"
            src={hills}
            alt=""
            formats={["avif"]}
            fallbackFormat="webp"
            widths={[320, 520]}
            sizes="(max-width: 640px) 46vw, 300px"
            loading="eager"
          />
        </div>
      </div>
      <span class="grass" aria-hidden="true"></span>
    </section>

    <div class="log paint">
      <div class="wrap layout">
        <nav class="index" aria-label="Releases">
          <div class="index-head">
            <p class="label">
              <span class="count-stable">{stable.length} releases</span>
              <span class="count-all">{stable.length} releases · {nightlyCount} {nightlyCount === 1 ? "nightly" : "nightlies"}</span>
            </p>
            {
              nightlyCount > 0 && (
                <fieldset class="view label" data-view-switch>
                  <legend class="visually-hidden">Show</legend>
                  <input type="radio" name="view" id="view-stable" value="stable" checked />
                  <label for="view-stable">Stable</label>
                  <input type="radio" name="view" id="view-all" value="all" />
                  <label for="view-all">Nightlies too</label>
                </fieldset>
              )
            }
          </div>
          <div class="index-scroll" data-index-scroll>
            {
              months.map((m) => (
                <div class:list={["month", { "nightly-only": onlyNightlies(m.releases) }]}>
                  <p class="label month-name">{m.label}</p>
                  <ol>
                    {m.releases.map((r) => (
                      <li class:list={{ nightly: r.nightly }}>
                        <a href={`#${r.version}`} data-index={r.version}>
                          <span class="index-version">{r.version}</span>
                          <span class="index-date">{dayMonth.format(r.date)}</span>
                        </a>
                      </li>
                    ))}
                  </ol>
                </div>
              ))
            }
          </div>
        </nav>

        <div class="entries">
          {
            nightlyCount > 0 && (
              <p class="nightly-note">
                <span class="label nightly-tag">Nightly</span>
                Wet paint: every fix the day it’s made, smudges and all.{" "}
                <a
                  class="link"
                  href={NIGHTLY}
                  data-track="download_clicked"
                  data-track-version="nightly"
                  data-track-channel="nightly"
                  data-track-location="release_notes">Get the nightly</a
                >. Back to stable any time in Settings › General. That never downgrades you: you stay put until the next
                stable catches up.
              </p>
            )
          }
          {
            releases.map((r, i) => (
              <article
                class:list={["entry", { latest: r === latest, nightly: r.nightly, folded: !r.open }]}
                id={r.version}
                aria-labelledby={`title-${r.version}`}
                style={`--dab: ${r.nightly ? nightlyDab : dabs[i % dabs.length]}`}
              >
                <header class="entry-head">
                  <p class="label meta">
                    <span class="here">You are here</span>
                    {r.nightly && <span class="nightly-tag">Nightly</span>}
                    <time datetime={isoDate(r.date)}>{longDate.format(r.date)}</time>
                    {r.summary && <span class="tally">{r.summary}</span>}
                  </p>
                  <h2 class="headline" id={`title-${r.version}`}>
                    <a href={`${base}/${releasePath(r.version)}`}>
                      <span class="poster version">
                        <span class="visually-hidden">Ardia </span>
                        {r.version}
                        <span class="visually-hidden">: </span>
                      </span>
                      <span class="headline-text">{r.headline}</span>
                    </a>
                  </h2>
                </header>
                {r.open ? (
                  <NotesBody html={r.html} video={r.video} />
                ) : (
                  <details class="fold" data-fold>
                    <summary class="label">
                      <span class="fold-open">Read the notes</span>
                      <span class="fold-close">Fold them back</span>
                    </summary>
                    <NotesBody html={r.html} video={r.video} />
                  </details>
                )}
              </article>
            ))
          }
        </div>
      </div>
    </div>

    <section class="end paint edge" aria-labelledby="end-title">
      <div class="wrap end-inner">
        <p class="label kicker">0.1.0 was the first</p>
        <h2 class="poster end-title" id="end-title">That’s all of them.</h2>
        <p class="end-line">Nothing before 0.1.0 was ever written down. Reading this in another browser? That can be arranged.</p>
        <DownloadButton location="release_notes" class="not-phone sun-btn" />
        <SendToMac location="release_notes" main />
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .masthead {
    --sky-top: #bccfd9;
    --sky-mid: #e1e4dc;
    --sky-low: #f7e5c2;
    position: relative;
    overflow: hidden;
    padding: clamp(36px, 6vw, 88px) 0 clamp(72px, 9vw, 128px);
    background-color: var(--sky-mid);
    background-image: var(--impasto-soft), linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 46%, var(--sky-low) 100%);
    background-size: 640px, 100% 100%;
    background-blend-mode: soft-light, normal;
  }
  .mast-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    align-items: end;
  }
  .mast-copy {
    grid-column: 1 / span 7;
    position: relative;
    z-index: 1;
  }
  .title {
    font-size: var(--t-mega);
    line-height: 0.82;
    margin-left: -0.04em;
  }
  .lede {
    margin-top: clamp(20px, 2.4vw, 32px);
    max-width: 24em;
    font-size: var(--t-lede);
    color: var(--ink-2);
  }
  .newest {
    grid-column: 8 / -1;
    align-self: end;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px 22px 22px;
    border-radius: 14px 22px 12px 24px / 20px 12px 24px 14px;
    background-color: #fbf6e9;
    background-image: var(--impasto-soft);
    background-size: 480px;
    background-blend-mode: soft-light;
    box-shadow:
      0 1px 2px rgb(22 25 26 / 0.12),
      0 22px 40px -26px rgb(22 25 26 / 0.5);
    color: var(--ink);
    text-decoration: none;
    rotate: -1deg;
    transition:
      rotate 300ms var(--ease-out),
      translate 300ms var(--ease-out);
  }
  @media (hover: hover) {
    .newest:hover {
      rotate: 0deg;
      translate: 0 -2px;
    }
  }
  .newest-tag {
    color: var(--ink-2);
  }
  .newest-version {
    font-size: clamp(3rem, 2rem + 3vw, 5.4rem);
    line-height: 0.84;
  }
  .newest-headline {
    font-size: clamp(1.15rem, 1rem + 0.5vw, 1.45rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .mast-art {
    position: absolute;
    right: calc(var(--gutter) - 2%);
    top: clamp(-24px, -1vw, 0px);
    width: min(300px, 26vw);
    aspect-ratio: 931 / 702;
    pointer-events: none;
  }
  .mast-art :global(.mast-sun) {
    position: absolute;
    left: 42.86%;
    top: 0;
    width: 26.85%;
    height: auto;
  }
  .mast-art :global(.mast-hills) {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: auto;
  }
  .grass {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: clamp(40px, 6vw, 84px);
    background: url("../assets/paint/grass.svg") 0 100% / auto 100% repeat-x;
    pointer-events: none;
  }

  .log {
    --bg: var(--noon);
    --wash: linear-gradient(180deg, #e9ead8 0%, var(--noon) 22%, var(--golden) 70%, var(--golden-late) 100%);
    padding: clamp(48px, 7vw, 104px) 0 var(--section);
  }
  .layout {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
  }

  .index {
    grid-column: 1 / span 3;
    align-self: start;
    position: sticky;
    top: 92px;
  }
  .index-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 12px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--ink);
    color: var(--ink-2);
  }
  .view {
    display: inline-flex;
    margin: 0;
    padding: 0;
    border: 1px solid var(--rule-strong);
    border-radius: 4px;
    overflow: hidden;
  }
  .view input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .view label {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 0 10px;
    color: var(--ink-2);
    cursor: pointer;
    user-select: none;
    transition:
      background-color 160ms,
      color 160ms;
  }
  .view label + input + label {
    border-left: 1px solid var(--rule-strong);
  }
  @media (pointer: coarse) {
    .view label {
      min-height: 40px;
      padding: 0 12px;
    }
  }
  .view input:checked + label {
    background-color: var(--ink);
    color: var(--paper);
  }
  .view input:focus-visible + label {
    outline: 2px solid var(--accent);
    outline-offset: -4px;
  }
  @media (hover: hover) {
    .view input:not(:checked) + label:hover {
      background-color: rgb(255 255 255 / 0.4);
      color: var(--ink);
    }
  }
  :global(:root[data-notes-view="stable"]) .log :is(.entry.nightly, .index li.nightly, .month.nightly-only, .count-all, .nightly-note),
  :global(:root:not([data-notes-view])) .log:not(:has(#view-all:checked)):not(:has(.entry.nightly:target))
    :is(.entry.nightly, .index li.nightly, .month.nightly-only, .count-all, .nightly-note) {
    display: none;
  }
  :global(:root[data-notes-view="all"]) .log .count-stable,
  :global(:root:not([data-notes-view])) .log:is(:has(#view-all:checked), :has(.entry.nightly:target)) .count-stable {
    display: none;
  }
  :global(:root[data-notes-view="all"]) .log .entry.latest:not(:first-of-type),
  :global(:root:not([data-notes-view])) .log:has(#view-all:checked) .entry.latest:not(:first-of-type) {
    padding-top: clamp(32px, 4vw, 52px);
    border-top: 1px solid var(--rule-strong);
  }
  :global(:root[data-notes-view="all"]) .log .entry:first-of-type,
  :global(:root:not([data-notes-view])) .log:has(#view-all:checked) .entry:first-of-type {
    padding-top: 0;
    border-top: 0;
  }
  .nightly-tag {
    display: inline-flex;
    align-items: center;
    padding: 1px 7px 0;
    border-radius: 3px;
    background-color: var(--night);
    color: var(--night-ink);
    letter-spacing: 0.08em;
  }
  .meta > .nightly-tag {
    margin-right: 10px;
  }
  .meta > .nightly-tag + *::before {
    content: none;
  }
  .nightly-note {
    max-width: 40em;
    margin-bottom: clamp(32px, 4vw, 48px);
    padding: 14px 16px 15px;
    border-radius: 4px;
    border: 1px solid var(--rule);
    background: rgb(255 255 255 / 0.28);
    font-size: var(--t-small);
    color: var(--ink-2);
  }
  .nightly-note .nightly-tag {
    margin-right: 8px;
    vertical-align: 0.1em;
  }
  .index li.nightly .index-version {
    font-size: 0.96rem;
  }
  .index-scroll {
    max-height: calc(100vh - 160px);
    max-height: calc(100dvh - 160px);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--rule) transparent;
    padding-right: 6px;
  }
  .month-name {
    padding: 18px 0 6px;
    color: var(--ink-3);
  }
  .index ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .index a {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding: 7px 0 7px 22px;
    border-bottom: 1px solid var(--rule);
    color: var(--ink-3);
    text-decoration: none;
    transition: color 150ms;
  }
  .index a::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 12px;
    height: 9px;
    margin-top: -4px;
    border-radius: 55% 45% 60% 40% / 60% 50% 50% 40%;
    background-color: var(--sun);
    background-image: var(--impasto);
    background-size: 120px;
    background-blend-mode: soft-light;
    rotate: -10deg;
    scale: 0;
    transition: scale 260ms var(--ease-out);
  }
  .index a:hover,
  .index a[aria-current="true"] {
    color: var(--ink);
  }
  .index a[aria-current="true"]::before {
    scale: 1;
  }
  .index-version {
    font-family: var(--poster);
    font-weight: 800;
    font-stretch: 75%;
    font-size: 1.08rem;
    letter-spacing: 0.01em;
    line-height: 1.2;
  }
  .index-date {
    font-family: var(--mono);
    font-size: var(--t-label);
    font-stretch: 87.5%;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .entries {
    grid-column: 5 / -1;
    min-width: 0;
  }
  .entry {
    padding: clamp(32px, 4vw, 52px) 0;
    border-top: 1px solid var(--rule-strong);
  }
  .entry.latest {
    padding-top: 0;
    border-top: 0;
  }
  .entry.folded {
    padding: 26px 0 24px;
    border-top-color: var(--rule);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 0;
    color: var(--ink-2);
  }
  .meta > * + *::before {
    content: "·";
    margin: 0 10px;
    color: var(--ink-3);
  }
  .meta > .here + *::before {
    content: none;
  }
  .here {
    display: none;
  }
  .headline {
    margin-top: 12px;
    font-weight: 560;
    font-stretch: 106%;
    letter-spacing: -0.028em;
  }
  .headline a {
    display: grid;
    gap: 10px;
    color: inherit;
    text-decoration: none;
  }
  .version {
    position: relative;
    justify-self: start;
    isolation: isolate;
    font-size: clamp(2.6rem, 1.8rem + 2.6vw, 4.4rem);
    line-height: 0.86;
    letter-spacing: -0.005em;
  }
  .version::before {
    content: "";
    position: absolute;
    z-index: -1;
    left: -0.16em;
    right: -0.2em;
    bottom: 0.02em;
    height: 0.42em;
    border-radius: 45% 55% 40% 60% / 60% 40% 60% 40%;
    background-color: var(--dab);
    background-image: var(--impasto);
    background-size: 160px;
    background-blend-mode: soft-light;
    opacity: 0.85;
    rotate: -1.4deg;
    transform-origin: 0 50%;
  }
  .headline-text {
    max-width: 22em;
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 2rem);
    line-height: 1.14;
    text-wrap: balance;
  }
  .latest .version {
    font-size: clamp(4.4rem, 2.2rem + 7vw, 9.6rem);
  }
  .latest .headline-text {
    max-width: 17em;
    font-size: clamp(1.8rem, 1.2rem + 2.1vw, 3.2rem);
    line-height: 1.04;
    letter-spacing: -0.034em;
  }
  .folded .version {
    font-size: clamp(2rem, 1.6rem + 1.4vw, 3rem);
  }
  .folded .headline a {
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    column-gap: clamp(16px, 2vw, 28px);
  }
  .folded .headline-text {
    max-width: 34em;
    font-size: clamp(1.15rem, 1.05rem + 0.4vw, 1.4rem);
  }
  .folded .version::before {
    opacity: 0.55;
  }
  .entry.nightly:not(.folded) {
    padding: clamp(28px, 3vw, 40px) 0;
  }
  .nightly .version {
    font-size: clamp(1.9rem, 1.5rem + 1.4vw, 2.8rem);
  }
  .nightly .headline-text {
    max-width: 30em;
    font-size: clamp(1.15rem, 1.05rem + 0.4vw, 1.4rem);
  }

  .entry:target .here {
    display: inline-flex;
    flex-basis: 100%;
    margin-bottom: 4px;
    color: var(--accent);
    font-weight: 560;
  }
  .entry:target .here::before {
    content: "↓";
    margin-right: 8px;
  }
  .entry:target .version::before {
    background-color: var(--sun);
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .entry:target .version::before {
      animation: swipe 800ms var(--ease-out) 200ms both;
    }
  }
  @keyframes swipe {
    from {
      scale: 0 1;
    }
  }

  .fold {
    margin-top: 16px;
  }
  .fold summary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding: 0 14px 0 12px;
    border-radius: 4px;
    border: 1px solid var(--rule-strong);
    color: var(--ink);
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: background-color 160ms;
  }
  .fold summary::-webkit-details-marker {
    display: none;
  }
  .fold summary::before {
    content: "+";
    font-size: 1rem;
    line-height: 1;
    width: 0.8em;
    text-align: center;
  }
  .fold[open] summary::before {
    content: "−";
  }
  @media (hover: hover) {
    .fold summary:hover {
      background-color: rgb(255 255 255 / 0.35);
    }
  }
  .fold-close,
  .fold[open] .fold-open {
    display: none;
  }
  .fold[open] .fold-close {
    display: inline;
  }

  .end {
    --bg: var(--dusk);
    --bg-top: #e3a585;
    --wash: linear-gradient(180deg, #e3a585 0%, var(--dusk) 50%, var(--dusk-late) 100%);
    --ink-2: #3f3437;
    --ink-3: #5a4a4e;
    --dab: var(--sun);
    padding: clamp(64px, 8vw, 120px) 0 clamp(96px, 10vw, 160px);
  }
  .end-inner {
    max-width: calc(var(--max) * 0.62);
    margin-inline: auto 0;
  }
  .end-title {
    font-size: var(--t-h2);
  }
  .end-line {
    margin: 20px 0 30px;
    max-width: 30em;
    font-size: var(--t-lede);
    color: var(--ink-2);
  }

  @media (max-width: 1100px) {
    .index {
      grid-column: 1 / span 3;
    }
    .entries {
      grid-column: 4 / -1;
    }
  }

  @media (max-width: 900px) {
    .mast-copy {
      grid-column: 1 / -1;
    }
    .newest {
      grid-column: 1 / span 10;
      margin-top: 36px;
    }
    .mast-art {
      width: min(240px, 34vw);
    }
    .index,
    .entries {
      grid-column: 1 / -1;
    }
    .index {
      position: static;
      margin: 0 calc(-1 * var(--gutter)) clamp(36px, 7vw, 56px);
    }
    .index-head {
      margin: 0 var(--gutter);
    }
    .index-scroll {
      display: flex;
      gap: 6px;
      max-height: none;
      overflow-x: auto;
      overflow-y: hidden;
      padding: 0 var(--gutter) 6px;
      scroll-snap-type: x proximity;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .index-scroll::-webkit-scrollbar {
      display: none;
    }
    .month {
      display: contents;
    }
    .month-name {
      display: none;
    }
    .index ol {
      display: contents;
    }
    .index li {
      flex: none;
      scroll-snap-align: start;
    }
    .index a {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
      min-height: 52px;
      margin-top: 12px;
      padding: 7px 12px 7px;
      border: 1px solid var(--rule);
      border-radius: 4px;
      background: rgb(255 255 255 / 0.28);
    }
    .index a::before {
      content: none;
    }
    .index a[aria-current="true"] {
      border-color: var(--ink);
      background-color: var(--sun);
    }
    .end-inner {
      max-width: none;
    }
  }

  @media (max-width: 640px) {
    .masthead {
      padding-bottom: 76px;
    }
    .title {
      font-size: clamp(4rem, 23vw, 7rem);
    }
    .mast-art {
      top: 4px;
      width: 34vw;
    }
    .newest {
      grid-column: 1 / -1;
      rotate: -0.6deg;
    }
    .folded .headline a {
      grid-template-columns: 1fr;
    }
    .tally {
      flex-basis: 100%;
    }
    .meta > .tally::before {
      content: none;
    }
  }
</style>

<script>
  import { track } from "../../scripts/track";

  const latest = document.querySelector<HTMLElement>(".entry:not(.nightly)")?.id ?? null;
  const viewed = (trigger: "load" | "hashchange") =>
    track("release_notes_viewed", { version: targetId() || null, latest, trigger });

  const root = document.documentElement;
  const viewSwitch = document.querySelector<HTMLFieldSetElement>("[data-view-switch]");
  const showAll = document.querySelector<HTMLInputElement>("#view-all");
  const viewKey = "ac:release-notes-view";
  const showView = (view: "all" | "stable") => {
    root.dataset.notesView = view;
    if (showAll) showAll.checked = view === "all";
  };
  if (showAll && root.dataset.notesView === "all" && !showAll.checked) showAll.checked = true;
  viewSwitch?.addEventListener("change", (e) => {
    const view = (e.target as HTMLInputElement).value === "all" ? "all" : "stable";
    showView(view);
    try {
      localStorage.setItem(viewKey, view);
    } catch {}
  });

  const isShown = (el: HTMLElement) => el.offsetParent !== null;
  const targetId = () => {
    try {
      return decodeURIComponent(location.hash.slice(1));
    } catch {
      return "";
    }
  };
  const revealTarget = () => {
    const id = targetId();
    if (!id) return;
    const entry = document.getElementById(id);
    const wantsNightly = entry ? entry.classList.contains("nightly") : /-nightly\.\d+$/.test(id);
    const hidden = entry ? !isShown(entry) : false;
    if (wantsNightly && root.dataset.notesView !== "all") showView("all");
    const fold = entry?.querySelector<HTMLDetailsElement>("[data-fold]");
    if (fold && !fold.open) fold.open = true;
    if (entry && hidden && isShown(entry)) entry.scrollIntoView({ block: "start" });
  };
  viewed("load");
  addEventListener("hashchange", () => {
    revealTarget();
    viewed("hashchange");
  });

  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>("[data-index]")].map((a) => [a.dataset.index!, a] as const),
  );
  const strip = document.querySelector<HTMLElement>("[data-index-scroll]");
  const visible = new Set<string>();
  const entries = [...document.querySelectorAll<HTMLElement>(".entry")];
  let current: string | undefined;
  const keepInView = (a: HTMLElement) => {
    if (!strip) return;
    const box = strip.getBoundingClientRect();
    const r = a.getBoundingClientRect();
    if (strip.scrollWidth > strip.clientWidth) {
      if (r.left < box.left || r.right > box.right) strip.scrollLeft += r.left - box.left - 24;
    } else if (r.top < box.top || r.bottom > box.bottom) strip.scrollTop += r.top - box.top - box.height / 3;
  };
  const mark = () => {
    const first = entries.find(isShown);
    const next = entries.find((e) => visible.has(e.id))?.id ?? (first && scrollY < first.offsetTop ? first.id : undefined);
    if (!next || next === current) return;
    current = next;
    for (const [version, a] of links) a.setAttribute("aria-current", String(version === current));
    const active = links.get(current);
    if (active) keepInView(active);
  };
  const watch = new IntersectionObserver(
    (changes) => {
      for (const c of changes) c.isIntersecting ? visible.add(c.target.id) : visible.delete(c.target.id);
      mark();
    },
    { rootMargin: "-40% 0px -55% 0px" },
  );
  for (const e of entries) watch.observe(e);
</script>
