---
import { colour } from "../data/press";
import { base } from "../data/site";
import { sentPath } from "../data/release";

const target = sentPath("mac");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ardia for Mac</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="48x48" />
    <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="canonical" href={new URL(`${base}/`, Astro.site)} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script is:inline define:vars={{ target }}>location.replace(target + location.hash);</script>
  </head>
  <body style={`background:${colour("Paper").toLowerCase()};color:${colour("Ink").toLowerCase()};font:16px/1.5 -apple-system,'Helvetica Neue',sans-serif;padding:24px`}>
    <a href={target}>Ardia for Mac</a>
  </body>
</html>
