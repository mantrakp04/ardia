{
  "expo": {
    "name": "Ardia",
    "slug": "ardia-phone",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.ardia.browser.android",
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "bundleIdentifier": "com.ardia.browser.ios"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Ardia uses the camera only to read the code your Mac shows when you connect.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
