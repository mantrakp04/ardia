require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")

require 'json'
require 'pathname'

podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}
deployment_target = podfile_properties['ios.deploymentTarget']

ENV['RCT_NEW_ARCH_ENABLED'] = '1'
ENV['RCT_USE_RN_DEP'] ||= '1'
ENV['RCT_USE_PREBUILT_RNCORE'] ||= '1'

platform :ios, deployment_target

prepare_react_native_project!

ardia_kit = Pathname.new(File.join(__dir__, '..', '..', 'ios', 'Packages', 'ArdiaKit')).cleanpath

link_ardia_kit = lambda do |installer|
  project = installer.pods_project
  reference = project.root_object.package_references.find do |package|
    package.is_a?(Xcodeproj::Project::Object::XCLocalSwiftPackageReference)
  end
  unless reference
    reference = project.new(Xcodeproj::Project::Object::XCLocalSwiftPackageReference)
    reference.relative_path = ardia_kit.relative_path_from(Pathname.new(project.project_dir)).to_s
    project.root_object.package_references << reference
  end
  target = project.targets.find { |t| t.name == 'ArdiaPhoneNative' }
  next unless target
  next if target.package_product_dependencies.any? { |d| d.product_name == 'ArdiaBrowser' }
  dependency = project.new(Xcodeproj::Project::Object::XCSwiftPackageProductDependency)
  dependency.package = reference
  dependency.product_name = 'ArdiaBrowser'
  target.package_product_dependencies << dependency
end

target 'Ardia' do
  use_expo_modules!

  config = use_native_modules!([
    'node',
    '--no-warnings',
    '--eval',
    'require(\'expo/bin/autolinking\')',
    'expo-modules-autolinking',
    'react-native-config',
    '--json',
    '--platform',
    'ios'
  ])

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => true,
  )

  post_install do |installer|
    react_native_post_install(installer, config[:reactNativePath], :mac_catalyst_enabled => false)

    installer.pods_project.targets.each do |t|
      t.build_configurations.each do |c|
        c.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = deployment_target
        c.build_settings['TARGETED_DEVICE_FAMILY'] = '1'
      end
    end

    link_ardia_kit.call(installer)
  end
end
