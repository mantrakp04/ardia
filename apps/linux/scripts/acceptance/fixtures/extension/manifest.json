{
  "manifest_version": 3,
  "name": "Ardia Acceptance Fixture",
  "version": "1.0",
  "description": "Exercises the toolbar action, popup, side panel and omnibox keyword.",
  "icons": { "16": "icon.png", "48": "icon.png", "128": "icon.png" },
  "action": { "default_title": "Fixture Action", "default_popup": "popup.html", "default_icon": { "32": "icon.png" } },
  "side_panel": { "default_path": "panel.html" },
  "permissions": ["sidePanel", "tabs"],
  "background": { "service_worker": "background.js" },
  "omnibox": { "keyword": "ardiafixture" }
}
