{
  "manifest_version": 3,
  "name": "Ardia Follow-up Fixture",
  "version": "1.0",
  "description": "Declares a search provider, keyboard commands and native messaging.",
  "action": { "default_title": "Follow-up Action", "default_popup": "popup.html" },
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+Y" } },
    "fixture-command": { "suggested_key": { "default": "Alt+Shift+U" }, "description": "Fixture command" }
  },
  "chrome_settings_overrides": {
    "search_provider": {
      "name": "Ardia Fixture Search",
      "keyword": "ardiasearch",
      "search_url": "https://search.ardia-fixture.example/?q={searchTerms}",
      "favicon_url": "https://search.ardia-fixture.example/favicon.ico",
      "encoding": "UTF-8",
      "is_default": false
    }
  }
}
