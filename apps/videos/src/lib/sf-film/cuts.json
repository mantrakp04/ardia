 "vo": [
  {
   "id": "vo1a",
   "beat": 1.5,
   "text": "Every group project has a chat like this."
  },
  {
   "id": "vo1b",
   "beat": 6.5,
   "text": "The links pile up."
  },
  {
   "id": "vo1c",
   "beat": 10,
   "text": "And someone always asks for the one from Tuesday."
  },
  {
   "id": "vo2",
   "beat": 17,
   "text": "So give them a better place."
  },
  {
   "id": "vo3",
   "beat": 27.5,
   "text": "Shared Folders puts one folder in everyone's sidebar."
  },
  {
   "id": "vo4a",
   "beat": 33,
   "text": "Share it right from the sidebar."
  },
  {
   "id": "vo4b",
   "beat": 37.5,
   "text": "Anyone with an Apple ID can join."
  },
  {
   "id": "vo4c",
   "beat": 43.5,
   "text": "They choose Add Shared Folder, and it's in their sidebar too."
  },
  {
   "id": "vo5a",
   "beat": 50,
   "text": "It's a real folder in iCloud Drive."
  },
  {
   "id": "vo5b",
   "beat": 54,
   "text": "So there's no new account to make."
  },
  {
   "id": "vo6a",
   "beat": 57.75,
   "text": "Drop a link in."
  },
  {
   "id": "vo6b",
   "beat": 62,
   "text": "Everyone has it, a moment later."
  },
  {
   "id": "vo7a",
   "beat": 67,
   "text": "Rename it."
  },
  {
   "id": "vo7b",
   "beat": 73.5,
   "text": "Reorder it."
  },
  {
   "id": "vo7c",
   "beat": 79.5,
   "text": "Or tuck it into a subfolder."
  },
  {
   "id": "vo7d",
   "beat": 83,
   "text": "It all stays in sync, both ways."
  },
  {
   "id": "vo8",
   "beat": 114.5,
   "text": "Shared Folders. Now in Ardia."
  }
 ]
