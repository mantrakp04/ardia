 "vo": [
  {
   "id": "vo1a",
   "beat": 1.5,
   "text": "Every group project has a chat like this."
  },
  {
   "id": "vo1b",
   "beat": 7.2,
   "text": "The links pile up."
  },
  {
   "id": "vo1c",
   "beat": 11.0,
   "text": "And someone always asks for the one from Tuesday."
  },
  {
   "id": "vo2",
   "beat": 18.25,
   "text": "So give them a better place."
  },
  {
   "id": "vo3",
   "beat": 31.5,
   "text": "Shared Folders puts one folder in everyone's sidebar."
  },
  {
   "id": "vo4b",
   "beat": 38.6,
   "text": "Anyone with an Apple ID can join."
  },
  {
   "id": "vo4c",
   "beat": 44.3,
   "text": "They choose Add Shared Folder, and it's in their sidebar too."
  },
  {
   "id": "vo5",
   "beat": 52.0,
   "text": "It's a real folder in iCloud Drive, so there's no new account to make."
  },
  {
   "id": "vo6a",
   "beat": 60.2,
   "text": "Drop a link in."
  },
  {
   "id": "vo6b",
   "beat": 64.0,
   "text": "Everyone has it, a moment later."
  },
  {
   "id": "vo7a",
   "beat": 68.6,
   "text": "Rename it."
  },
  {
   "id": "vo7b",
   "beat": 74.2,
   "text": "Reorder it."
  },
  {
   "id": "vo7c",
   "beat": 82.75,
   "text": "Or tuck it into a subfolder."
  },
  {
   "id": "vo9a",
   "beat": 88.0,
   "text": "Plan a trip."
  },
  {
   "id": "vo9b",
   "beat": 92.4,
   "text": "Or run a whole class."
  },
  {
   "id": "vo8",
   "beat": 101.5,
   "text": "Shared Folders. Now in Ardia."
  }
 ]
