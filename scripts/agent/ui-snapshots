  mail: "Inbox", calendar: "Calendar", docs: "Design doc", notes: "Meeting notes", reading: "Reading list",
  research1: "Swift concurrency", research2: "Metal shaders", work1: "Roadmap", work2: "Quarterly plan",
};

function writePages() {
  mkdirSync(PAGES, { recursive: true });
  for (const [name, title] of Object.entries(PAGE_TITLES)) {
    const html = `<!doctype html><html><head><meta charset="utf-8"><title>${title}</title></head><body style="font:16px -apple-system;margin:40px"><h1>${title}</h1><p>Find me: needle haystack needle.</p></body></html>`;
    const path = join(PAGES, `${name}.html`);
    if (!existsSync(path) || readFileSync(path, "utf8") !== html) writeFileSync(path, html);
  }
}

