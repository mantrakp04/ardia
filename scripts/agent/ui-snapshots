  console.log(lines.slice(0, lines.findIndex((l) => !l.startsWith("//"))).map((l) => l.replace(/^\/\/ ?/, "")).join("\n"));
};

const argv = process.argv.slice(2);
if (!argv.length || argv.includes("-h") || argv.includes("--help")) {
  help();
  process.exit(argv.length ? 0 : 64);
}
const flags = {}, positional = [];
for (let i = 1; i < argv.length; i++) {
  if (argv[i] === "--keep") flags.keep = true;
  else if (argv[i].startsWith("--")) flags[argv[i].slice(2)] = argv[++i];
  else positional.push(argv[i]);
}

function readPng(path) {
  const buf = readFileSync(path);
  let width = 0, height = 0, channels = 4;
  const idat = [];
  for (let at = 8; at < buf.length; ) {
    const length = buf.readUInt32BE(at), type = buf.toString("ascii", at + 4, at + 8);
    if (type === "IHDR") {
      width = buf.readUInt32BE(at + 8);
      height = buf.readUInt32BE(at + 12);
      if (buf[at + 16] !== 8 || buf[at + 20] !== 0) throw new Error(`${path}: only 8-bit non-interlaced PNGs`);
      channels = { 0: 1, 2: 3, 4: 2, 6: 4 }[buf[at + 17]];
    } else if (type === "IDAT") idat.push(buf.subarray(at + 8, at + 8 + length));
    at += 12 + length;
  }
  const raw = inflateSync(Buffer.concat(idat));
  const stride = width * channels;
  const out = Buffer.alloc(stride * height);
  for (let y = 0; y < height; y++) {
    const filter = raw[y * (stride + 1)];
    const row = y * stride, src = y * (stride + 1) + 1;
    for (let x = 0; x < stride; x++) {
      const v = raw[src + x];
      const a = x >= channels ? out[row + x - channels] : 0;
      const b = y ? out[row - stride + x] : 0;
      const c = y && x >= channels ? out[row - stride + x - channels] : 0;
      let p;
      if (filter === 0) p = v;
      else if (filter === 1) p = v + a;
      else if (filter === 2) p = v + b;
      else if (filter === 3) p = v + ((a + b) >> 1);
      else {
        const pa = Math.abs(b - c), pb = Math.abs(a - c), pc = Math.abs(a + b - 2 * c);
        p = v + (pa <= pb && pa <= pc ? a : pb <= pc ? b : c);
      }
      out[row + x] = p & 255;
    }
  }
  const rgba = Buffer.alloc(width * height * 4);
  for (let i = 0; i < width * height; i++) {
    const s = i * channels;
    const grey = channels <= 2;
    rgba[i * 4] = out[s];
    rgba[i * 4 + 1] = grey ? out[s] : out[s + 1];
    rgba[i * 4 + 2] = grey ? out[s] : out[s + 2];
    rgba[i * 4 + 3] = channels === 4 ? out[s + 3] : channels === 2 ? out[s + 1] : 255;
  }
  return { width, height, rgba };
}

const crcTable = Array.from({ length: 256 }, (_, n) => {
  let c = n;
  for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
  return c >>> 0;
});
const crc32 = (buf) => {
  let c = 0xffffffff;
  for (const b of buf) c = crcTable[(c ^ b) & 255] ^ (c >>> 8);
  return (c ^ 0xffffffff) >>> 0;
};
function writePng(path, { width, height, rgba }) {
  const chunk = (type, data) => {
    const head = Buffer.alloc(8);
    head.writeUInt32BE(data.length);
    head.write(type, 4, "ascii");
    const crc = Buffer.alloc(4);
    crc.writeUInt32BE(crc32(Buffer.concat([head.subarray(4), data])));
    return Buffer.concat([head, data, crc]);
  };
  const ihdr = Buffer.alloc(13);
  ihdr.writeUInt32BE(width);
  ihdr.writeUInt32BE(height, 4);
  ihdr[8] = 8;
  ihdr[9] = 6;
  const raw = Buffer.alloc((width * 4 + 1) * height);
  for (let y = 0; y < height; y++) rgba.copy(raw, y * (width * 4 + 1) + 1, y * width * 4, (y + 1) * width * 4);
  writeFileSync(path, Buffer.concat([Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]), chunk("IHDR", ihdr), chunk("IDAT", deflateSync(raw)), chunk("IEND", Buffer.alloc(0))]));
}

function diffImages(a, b) {
  if (a.width !== b.width || a.height !== b.height) return { pixels: Math.max(a.width * a.height, b.width * b.height), maxDelta: 255, size: `${a.width}x${a.height} → ${b.width}x${b.height}` };
  let pixels = 0, maxDelta = 0;
  const mask = Buffer.alloc(a.rgba.length);
  for (let i = 0; i < a.rgba.length; i += 4) {
    let d = 0;
    for (let k = 0; k < 4; k++) d = Math.max(d, Math.abs(a.rgba[i + k] - b.rgba[i + k]));
    if (d) {
      pixels++;
      maxDelta = Math.max(maxDelta, d);
      mask[i] = 255; mask[i + 1] = 0; mask[i + 2] = 0; mask[i + 3] = 255;
    } else {
      for (let k = 0; k < 3; k++) mask[i + k] = b.rgba[i + k] * 0.3;
      mask[i + 3] = 255;
    }
  }
  return { pixels, maxDelta, image: { width: a.width, height: a.height, rgba: mask } };
}

function compare(beforeDir, afterDir, tolerance) {
  const pngs = (dir) => new Set(readdirSync(dir).filter((f) => f.endsWith(".png")));
  const before = pngs(beforeDir), after = pngs(afterDir);
  const failedIn = (dir) => {
    try { return JSON.parse(readFileSync(join(dir, "states.json"), "utf8")).filter((s) => s.error).map((s) => s.name); } catch { return []; }
  };
  const diffDir = join(afterDir, "diff");
  rmSync(diffDir, { recursive: true, force: true });
  let bad = 0, same = 0;
  for (const file of [...new Set([...before, ...after])].sort()) {
    const name = file.replace(/\.png$/, "");
    if (!before.has(file) || !after.has(file)) {
      bad++;
      console.log(`MISSING  ${name} (only in ${before.has(file) ? "before" : "after"})`);
      continue;
    }
    const a = readFileSync(join(beforeDir, file)), b = readFileSync(join(afterDir, file));
    if (a.equals(b)) {
      same++;
      continue;
    }
    const d = diffImages(readPng(join(beforeDir, file)), readPng(join(afterDir, file)));
    if (d.image && d.pixels) {
      mkdirSync(diffDir, { recursive: true });
      writePng(join(diffDir, file), d.image);
    }
    const over = d.pixels > tolerance;
    if (over) bad++;
    else same++;
    console.log(`${over ? "DIFF    " : "within  "} ${name}: ${d.pixels} px, max channel delta ${d.maxDelta}${d.size ? ` (size ${d.size})` : ""}`);
  }
  for (const [side, dir] of [["before", beforeDir], ["after", afterDir]])
    for (const name of failedIn(dir)) {
      bad++;
      console.log(`FAILED   ${name} (capture failed in ${side})`);
    }
  console.log(`${same} identical, ${bad} different${bad && existsSync(diffDir) ? ` (diffs in ${diffDir})` : ""}`);
  return bad ? 1 : 0;
}

