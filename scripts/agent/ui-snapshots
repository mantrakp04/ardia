async function capture(appPath, outDir) {
  outDir = resolve(outDir);
  const only = flags.only ? new Set(flags.only.split(",")) : null;
  const states = only ? STATES.filter((s) => only.has(s.name)) : STATES;
  if (!states.length) throw new Error(`no such state: ${flags.only}`);
  mkdirSync(outDir, { recursive: true });
  for (const f of readdirSync(outDir)) if (f.endsWith(".png")) rmSync(join(outDir, f));
  await takeLock();
  const data = DATA;
  try { await attach(data).quit(); } catch {}
  rmSync(data, { recursive: true, force: true });
  mkdirSync(data, { recursive: true });
  writePages();
  const probes = join(data, "probes");
  mkdirSync(probes, { recursive: true });
  const app = await launch(appPath, {
    data, onboarded: true, session: fixture(), js: flags.js, switches: ["--proxy-server=http://127.0.0.1:9"],
    files: { "telemetry.json": { version: 1, sharing: false, decidedAt: 1, askDoneAt: 1, installId: null, crashCursor: 0, lastVersion: null, sessionOpen: false } },
  });
  console.log(`instance pid ${app.pid} port ${app.port} data ${data}`);
  const run = (body, timeout = 20000) => app.eval(`${HELPERS}\n${body}`, { timeout });
  const results = [];
  try {
    await run(`return settle(1500).then(() => !!st().windows[W]);`);
    console.log(`seed ${JSON.stringify(await run(SEED))}`);
    console.log(`content blocker ${await uboReady(app.port)}`);
    await run(`return settle(1500);`);
    for (const state of states) {
      const t0 = Date.now();
      try {
        await run(reset);
        await run(`return settle(300);`);
        const result = await run(state.body || "return null;");
        const file = await settled(run, state.window, probes, join(outDir, `${state.name}.png`), state.stableFor);
        results.push({ name: state.name, window: state.window, ms: Date.now() - t0, probes: file.probes, setup: result ?? undefined });
        console.log(`ok   ${state.name} (${file.probes} snapshots, ${Date.now() - t0} ms)`);
      } catch (e) {
        results.push({ name: state.name, window: state.window, error: String(e.message ?? e) });
        console.log(`FAIL ${state.name}: ${e.message ?? e}`);
      } finally {
        if (state.window !== "w1" && !state.keepOpen) await run(`return ac.runCommand({ command: "closeTab", arg: null, windowId: ${JSON.stringify(state.window)} });`).catch(() => {});
      }
    }
    await run(`return ac.runCommand({ command: "closeTab", arg: null, windowId: "settings" });`).catch(() => {});
  } finally {
    writeFileSync(join(outDir, "states.json"), JSON.stringify(results, null, 2));
    const head = spawnSync("git", ["-C", dirname(here), "rev-parse", "HEAD"], { encoding: "utf8" }).stdout.trim();
    const dirty = spawnSync("git", ["-C", dirname(here), "status", "--short", "--", "apps/browser/src", "packages"], { encoding: "utf8" }).stdout.trim();
    writeFileSync(join(outDir, "manifest.json"), JSON.stringify({
      app: resolve(appPath), js: flags.js ?? "this checkout (Metro :8081, pinned)", commit: head, uncommitted: dirty ? dirty.split("\n") : [],
      capturedAt: new Date().toISOString(), states: results.map((r) => r.name),
    }, null, 2));
    if (!flags.keep) await app.quit();
    rmSync(probes, { recursive: true, force: true });
    if (!flags.keep) rmSync(LOCK, { force: true });
  }
  const failed = results.filter((r) => r.error).length;
  console.log(`${results.length - failed} captured, ${failed} failed → ${outDir}`);
  return failed ? 1 : 0;
}

async function takeLock() {
  mkdirSync(ROOT, { recursive: true });
  for (const end = Date.now() + 540_000; ; await sleep(2000)) {
    let holder = null;
    try { holder = Number(readFileSync(LOCK, "utf8")); } catch {}
    const alive = holder && (() => { try { process.kill(holder, 0); return true; } catch (e) { return e.code === "EPERM"; } })();
    if (!alive) {
      writeFileSync(LOCK, String(process.pid));
      if (Number(readFileSync(LOCK, "utf8")) === process.pid) return;
    }
    if (Date.now() > end) throw new Error(`another capture (pid ${holder}) holds ${LOCK}`);
    if (alive) console.log(`waiting for the capture in pid ${holder} (one at a time: the data dir path shows in the UI)`);
  }
}

async function settled(run, windowId, probes, out, stableFor = 1) {
  let previous = null, same = 0;
  for (let i = 0; i < 40 + stableFor; i++) {
    const path = join(probes, `${i % 2}.png`);
    const ok = await run(`return ac.shell.devSnapshotWindow(${JSON.stringify(windowId)}, ${JSON.stringify(path)}, true);`);
    if (!ok) {
      await sleep(250);
      continue;
    }
    const bytes = readFileSync(path);
    same = previous && bytes.equals(previous) ? same + 1 : 0;
    if (i >= 2 && same >= stableFor) {
      writeFileSync(out, bytes);
      return { probes: i + 1 };
    }
    previous = bytes;
    await sleep(250);
  }
  throw new Error(`${windowId} never settled (or never snapshotted) in 40 snapshots`);
}

const [command] = argv;
try {
  if (command === "list") console.log(STATES.map((s) => `${s.name}  (${s.window})`).join("\n"));
  else if (command === "capture") {
    if (positional.length < 2) throw new Error("usage: ui-snapshots capture <Debug app> <out dir>");
    process.exitCode = await capture(positional[0], positional[1]);
  } else if (command === "compare") {
    if (positional.length < 2) throw new Error("usage: ui-snapshots compare <before dir> <after dir>");
    process.exitCode = compare(resolve(positional[0]), resolve(positional[1]), Number(flags.tolerance ?? 0));
  } else {
    help();
    process.exitCode = 64;
  }
} catch (e) {
  console.error(e.message ?? e);
  process.exitCode = 1;
}
process.exit(process.exitCode);
