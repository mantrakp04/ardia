#!/usr/bin/env node
// Hidden test instances from the shell (scripts/lib/instance.mjs): launch one, run JS in the app or a page, quit it.
//
//   scripts/agent/ac launch <app> [--data DIR] [--port N] [--js pinned|live|none|host:port] [--env K=V]…
//                               [--instance K=V]… [--test K[=V]]… [--trace AREA]… [--switch S]…
//                               [--session FILE.json] [--onboarded] [--no-wait] [--runs-from APP] [--arg A]…
//   scripts/agent/ac eval   <data dir> '<body>' [--timeout MS]   the dev harness: `return …` (a promise is awaited)
//   scripts/agent/ac page   <data dir> <url part> '<expression>'  a page's DevTools Runtime.evaluate (awaited, by value)
//   scripts/agent/ac quit   <data dir> [--kill]                   the app's quit, then SIGTERM, then SIGKILL
//   scripts/agent/ac status [<data dir>]                          that instance, or every running instance of any build
//   scripts/agent/ac -h | --help
//
// launch prints `pid port data log` and records the instance in <data>/instance.json; every other command finds it
// there, and only ever signals that process (pid, start time and binary). The app runs hidden (ARDIA_BACKGROUND=1,
// `open -g -n`) with Metro pinned by default (a proxy that refuses reloads: other agents' edits don't restart it).
// --instance, --test and --trace fill ARDIA_INSTANCE, ARDIA_TEST and ARDIA_TRACE (keys: docs/agent-brief.md); --switch
// adds a Chrome switch (ARDIA_INSTANCE chromiumSwitches), --arg one launch argument (`--arg=-AppleLanguages --arg='(zh-Hans)'`
// sets this instance's languages and nothing else's). A build from before ArdiaLaunchConfig gets the old variables.
// Body or expression `-` reads stdin. Exit 1 on a failure, 3 when the instance has gone.
import { readFileSync } from "node:fs";
import { spawnSync } from "node:child_process";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const lib = join(dirname(fileURLToPath(import.meta.url)), "../lib/instance.mjs");
const { attach, launch, mergeLaunchEnv } = await import(lib);

const argv = process.argv.slice(2);
const help = () => {
  const lines = readFileSync(fileURLToPath(import.meta.url), "utf8").split("\n").slice(1);
  console.log(lines.slice(0, lines.findIndex((l) => !l.startsWith("//"))).map((l) => l.replace(/^\/\/ ?/, "")).join("\n"));
};
if (!argv.length || argv.includes("-h") || argv.includes("--help")) {
  help();
  process.exit(argv.length ? 0 : 64);
}
const [command, ...rest] = argv;
const flags = {}, positional = [];
for (let i = 0; i < rest.length; i++) {
  const a = rest[i];
  if (!a.startsWith("--")) positional.push(a);
  else if (["--onboarded", "--no-wait", "--kill"].includes(a)) flags[a.slice(2)] = true;
  else if (a.startsWith("--arg=")) (flags.arg ??= []).push(a.slice(6));
  else if (["--env", "--switch", "--instance", "--test", "--trace", "--arg"].includes(a)) (flags[a.slice(2)] ??= []).push(rest[++i]);
  else flags[a.slice(2)] = rest[++i];
}
const input = (s) => (s === "-" ? readFileSync(0, "utf8") : s);
const print = (v) => console.log(typeof v === "string" ? v : JSON.stringify(v, null, 2));
const found = (dir) => {
  try {
    return attach(dir);
  } catch (e) {
    console.error(e.message);
    process.exit(e.gone ? 3 : 1);
  }
};

try {
  if (command === "launch") {
    if (!positional[0]) throw new Error("usage: ac launch <app> [--data DIR] …");
    const pairs = (list) => Object.fromEntries((list ?? []).map((kv) => (kv.includes("=") ? [kv.slice(0, kv.indexOf("=")), kv.slice(kv.indexOf("=") + 1)] : [kv, true])));
    const app = await launch(positional[0], {
      data: flags.data, port: flags.port, js: flags.js, switches: flags.switch, onboarded: flags.onboarded,
      env: mergeLaunchEnv(...(flags.env ?? []).map((kv) => pairs([kv]))),
      instance: pairs(flags.instance), test: pairs(flags.test), trace: flags.trace ?? [],
      session: flags.session ? JSON.parse(readFileSync(flags.session, "utf8")) : undefined, ready: !flags["no-wait"],
      runsFrom: flags["runs-from"], args: flags.arg,
    });
    console.log(`pid ${app.pid} port ${app.port} data ${app.data} log ${app.log}`);
    process.exit(0);
  } else if (command === "eval") {
    const app = found(positional[0]);
    print(await app.eval(input(positional[1] ?? "-"), { timeout: Number(flags.timeout ?? 20000) }));
  } else if (command === "page") {
    const app = found(positional[0]);
    const page = await app.page(positional[1]);
    print(await page.eval(input(positional[2] ?? "-"), { userGesture: true }));
    page.close();
  } else if (command === "quit") {
    const app = found(positional[0]);
    print(await app.quit({ graceful: !flags.kill }));
  } else if (command === "status") {
    if (positional[0]) {
      const app = found(positional[0]);
      const harness = await app.eval("return true", { timeout: 2000 }).then(() => "answers", (e) => `no answer (${e.message})`);
      print({ pid: app.pid, port: app.port, data: app.data, app: app.app, log: app.log, started: app.started, harness });
    } else {
      const ps = spawnSync("ps", ["-E", "-ww", "-ax", "-o", "pid=,command="], { encoding: "utf8" }).stdout.split("\n");
      for (const line of ps) {
        const m = /^\s*(\d+)\s+(\S.*?\/Contents\/MacOS\/Ardia)(?:\s|$)/.exec(line);
        if (!m || line.includes("--type=")) continue;
        const data = / ARDIA_DATA_DIR=(\S+)/.exec(line)?.[1] ?? "(no data dir: not a test instance)";
        console.log(`${m[1]}  ${data}  ${m[2].replace(/\/Contents\/MacOS\/Ardia$/, "")}`);
      }
    }
  } else {
    help();
    process.exit(64);
  }
} catch (e) {
  console.error(e.message ?? e);
  process.exit(1);
}
process.exit(0);
