--- a/chrome/install_static/user_data_dir.cc
+++ b/chrome/install_static/user_data_dir.cc
@@ -119,6 +119,22 @@
 
   GetUserDataDirFromRegistryPolicyIfSet(mode, &user_data_dir);
 
+  // Ardia: a launch with its own data directory (ARDIA_DATA_DIR, a test
+  // instance) keeps Chromium's data inside it, as on the Mac.
+  if (user_data_dir.empty()) {
+    wchar_t data_dir[MAX_PATH];
+    DWORD length =
+        ::GetEnvironmentVariableW(L"ARDIA_DATA_DIR", data_dir, MAX_PATH);
+    if (length > 0 && length < MAX_PATH) {
+      user_data_dir.assign(data_dir, length);
+      while (!user_data_dir.empty() &&
+             (user_data_dir.back() == '\\' || user_data_dir.back() == '/')) {
+        user_data_dir.pop_back();
+      }
+      user_data_dir.append(L"\\Chromium");
+    }
+  }
+
