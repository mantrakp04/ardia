+// Ardia: the app's own timeout for an export is two minutes; a confirmation
+// that arrives after this counts as refused, so nothing is written once the
+// app has given up.
+constexpr base::TimeDelta kArdiaConfirmationDeadline = base::Seconds(110);
+
+HWND ArdiaPromptWindow() {
+  return g_ardia_win_prompt_window ? g_ardia_win_prompt_window() : nullptr;
+}
+
+void CloseArdiaPrompts(HWND parent) {
+  HWND prompt = nullptr;
+  while ((prompt = ::FindWindowExW(nullptr, prompt,
+                                   L"Credential Dialog Xaml Host", nullptr))) {
+    if (::GetWindow(prompt, GW_OWNER) == parent) {
+      ::PostMessageW(prompt, WM_CLOSE, 0, 0);
+    }
+  }
+}
+
+using ArdiaAnswer = std::shared_ptr<base::OnceCallback<void(bool)>>;
+
+base::OnceCallback<void(bool)> ArdiaWithDeadline(
+    base::OnceCallback<void(bool)> done) {
+  ArdiaAnswer answer =
+      std::make_shared<base::OnceCallback<void(bool)>>(std::move(done));
+  HWND parent = ArdiaPromptWindow();
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](ArdiaAnswer answer, HWND parent) {
+            if (!*answer) {
+              return;
+            }
+            std::move(*answer).Run(false);
+            CloseArdiaPrompts(parent);
+          },
+          answer, parent),
+      kArdiaConfirmationDeadline);
+  return base::BindOnce(
+      [](ArdiaAnswer answer, bool authenticated) {
+        if (*answer) {
+          std::move(*answer).Run(authenticated);
+        }
+      },
+      answer);
+}
