{
  "name": "ardia",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@ardia/browser",
    "macos": "pnpm --filter @ardia/browser macos",
    "pods": "pnpm --filter @ardia/browser pods",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "shaders:check": "turbo run shaders:check",
    "test": "turbo run test && node --no-warnings --test extras/raycast-ardia/src/scripts.test.ts \"scripts/**/*.test.mjs\" \"apps/site/src/**/*.test.ts\""
  },
  "devDependencies": {
    "turbo": "^2.11.3",
    "typescript": "~5.9.2"
  },
  "license": "SEE LICENSE IN NOTICE"
}
